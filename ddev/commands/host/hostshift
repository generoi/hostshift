#!/usr/bin/env bash
#ddev-generated
## Description: configure hostshift for this DDEV project
## Usage: hostshift [init|check|copy-db|loopback|env|wp-cli] [--slug NAME]
## Example: "ddev hostshift init"
##
## Scaffolding a DDEV project is opinionated work, and this is where it is
## allowed to be. The hostshift binary maps origins; it can *read* this
## project's declared hostnames as one source for that map, and it deliberately
## does not write .ddev/ files, guess slugs from branches, or decide which
## hostnames `web` should keep. A binary with a `ddev init` subcommand would be
## a tool for one shop; this command is the shop.
##
## #ddev-generated, and it has to be. Without that marker `ddev add-on get`
## refuses to overwrite this file, so an upgrade installs a new compose file
## beside the old command — and the two halves disagree about the variable names
## they pass between them. Renaming HOSTSHIFT_SLUG/HOSTSHIFT_MAP_ARGS to
## HOSTSHIFT_ARGS did exactly that: init wrote the old names, compose read the
## new one, the proxy started with its inert default and every variant 421'd,
## with `init`, `restart` and `check` all reporting success.
##
## The cost is that a local edit here is lost on the next `ddev add-on get`.
## That is the right trade for a file whose whole job is to stay in step with the
## compose file it ships beside. The loopback override is the opposite case and
## deliberately carries no marker.
##
## Needs the hostshift binary on PATH. Everything generic comes from it — the
## map, the variants, the hostnames a checkout declares — and everything
## DDEV-shaped is assembled here.

set -euo pipefail

# Every path below is relative to the project root, and `ddev` may be run from
# anywhere inside the project.
[ -n "${DDEV_APPROOT:-}" ] && cd "$DDEV_APPROOT"

cmd="${1:-init}"; shift || true
slug=""
branch=""
dry_run=""
force=""
quiet=""
claimed=""
while [ $# -gt 0 ]; do
  case "$1" in
    --slug) slug="${2:?--slug needs a value}"; shift 2 ;;
    --slug=*) slug="${1#*=}"; shift ;;
    --dry-run|-n) dry_run=1; shift ;;
    --quiet|-q) quiet=1; shift ;;
    --force) force=1; shift ;;
    # Silently discarding an unknown flag is how `--dry-run` came to write the
    # files it was passed to prevent.
    *) echo "unknown argument: $1" >&2
       echo "usage: ddev hostshift [init|check|copy-db|loopback|env|wp-cli] [--slug NAME]" >&2
       exit 2 ;;
  esac
done

case "$cmd" in
  init|check|copy-db|loopback|env|wp-cli) ;;
  -h|--help|help)
    echo "usage: ddev hostshift [init|check|copy-db|loopback|env|wp-cli] [--slug NAME]"; exit 0 ;;
  *) echo "usage: ddev hostshift [init|check|copy-db|loopback|env|wp-cli] [--slug NAME]" >&2; exit 2 ;;
esac

# The post-start hook runs `check` on every start. Between `ddev add-on get` and
# `ddev hostshift init` — and permanently, for anyone who installed the add-on
# and never used it — there is nothing to check, and saying so in nine lines plus
# a `Task failed` is how an add-on stops being inert until it is configured.
#
# $HOSTSHIFT_HOOK, not a flag, and that is not a style choice.
# `config.hostshift.yaml` carries #ddev-generated so `ddev add-on get` replaces
# it on upgrade. This file only gained that marker *after* v0.1.0, so DDEV
# refuses to replace it — an upgraded project runs the new hook against the old
# command, and the old parser exits 2 on any flag it does not know. Measured on a
# real upgrade: `unknown argument: --quiet`, `Task failed`, `Successfully
# started`. The proxy kept serving, so nothing looked wrong, and the post-start
# check was dead from then on: every later drift — a renamed directory, a changed
# branch, a stale .env, a crashed proxy, a hijacked hostname — went unreported on
# exactly the projects that had been running longest.
#
# `bash -c` runs the hook line (ddev pkg/ddevapp/task.go, ExecHostTask.Execute),
# so an environment prefix is a plain assignment there, and a parser that only
# reads "$@" cannot trip over it. The rule the compose file states — anything
# added must work against what is already deployed — covers the hook line too.
#
# Only this short-circuit is gated. `ddev hostshift check` typed by a person on a
# project with no configuration is a question that deserves an answer, and it
# still gets one.
if [ "$cmd" = "check" ] && { [ -n "$quiet" ] || [ -n "${HOSTSHIFT_HOOK:-}" ]; } \
   && ! grep -qs '^HOSTSHIFT_' .ddev/.env 2>/dev/null; then
  exit 0
fi

command -v hostshift >/dev/null || {
  echo "hostshift is not on PATH — https://github.com/generoi/hostshift" >&2; exit 1; }

# A worktree exists to hold a branch, so the branch is the slug unless told
# otherwise. Guessing this is exactly the kind of opinion the binary should not
# carry and a project-level command should.
#
# LC_ALL=C because the pipeline works on bytes: under a UTF-8 locale BSD sed
# aborts with "RE error: illegal byte sequence" on a branch named
# feature/käyttöliittymä, and en_US.UTF-8 is the macOS default in a Finnish
# shop. The trim runs after the truncation as well as before it, or a slug cut
# at 30 characters can end in a hyphen and derive "…abc---site.ddev.site".
# copy-db maps nothing, so it needs no slug — and refusing to copy a database
# because the branch name has no letters in it, or because HEAD is detached
# during a rebase, is a refusal with no reason behind it.
if [ -z "$slug" ] && [ "$cmd" != "copy-db" ]; then
  branch="$(git symbolic-ref --short HEAD 2>/dev/null || true)"
  # Detached HEAD is ordinary — a rebase, a bisect, a checked-out tag — and it
  # must not stop `check`, which the post-start hook runs on every start. The
  # deployed slug is right there in .ddev/.env.
  if [ -z "$branch" ] && [ "$cmd" = "check" ]; then
    # Any slug will do on the --from/--to path, where it is never read; on the
    # --slug path the deployed one is in .ddev/.env. Either way `check` must not
    # refuse during a rebase, a bisect or a checked-out tag — the hook runs it on
    # every start, and refusing means the staleness check silently stops running
    # for the duration.
    # Two shapes to recover from, and reading only the first is why this has
    # shipped broken twice: HOSTSHIFT_ARGS is `--slug X` only when a
    # hostshift.yaml is present. On the README's headline path it is
    # `--from … --to …`, and the deployed slug is the prefix of the first
    # variant — wt-a--acme.ddev.site — which is present in both shapes.
    slug="$(sed -n '/^HOSTSHIFT_ARGS=--slug /{s///p;q;}' .ddev/.env 2>/dev/null)"
    if [ -z "$slug" ]; then
      slug="$(sed -n '/^HOSTSHIFT_VARIANTS=/{s///p;q;}' .ddev/.env 2>/dev/null \
        | cut -d, -f1 | sed -n 's/--.*//p')"
    fi
    slug="${slug:-wt}"
  fi
  [ -n "$branch" ] || [ -n "$slug" ] || { echo "no git branch here — pass --slug" >&2; exit 2; }
fi

# Derive from the branch only when nothing above supplied one — the recovered
# slug used to be overwritten here two lines after it was found, which is why
# the detached-HEAD fallback never worked.
if [ -z "$slug" ] && [ -n "$branch" ]; then
  slug="$(printf '%s' "$branch" \
    | LC_ALL=C tr '[:upper:]' '[:lower:]' \
    | LC_ALL=C sed -e 's/[^a-z0-9]\{1,\}/-/g' \
    | LC_ALL=C cut -c1-30 \
    | LC_ALL=C sed -e 's/^-\{1,\}//' -e 's/-\{1,\}$//')"
  [ -n "$slug" ] || {
    echo "the branch $branch has no letters or digits to make a hostname label from — pass --slug" >&2
    exit 2; }
  echo "hostshift: slug \"$slug\", from the git branch $branch" >&2
fi

case "$slug" in
  *[!a-z0-9-]*|-*|*-)
    echo "hostshift: slug \"$slug\" is not a hostname label — use lowercase letters," >&2
    echo "  digits and hyphens, not starting or ending with one. It becomes part of a" >&2
    echo "  hostname and of the proxy's command line, where a space, quote, \$, ; or ," >&2
    echo "  silently truncates or corrupts the map." >&2
    exit 2 ;;
esac

# What this project answers to.  `hostshift hosts` reads the DDEV config with
# its config.*.yaml override merging — parsing that here would be the place the
# careful parts get lost.
hosts="$(hostshift hosts)"

# In the checkout a worktree branches *from*, there is no canonical/variant
# distinction to make: its own hostnames are the ones the database holds. Running
# init here points web at nothing and hands the variants to a proxy nobody routes
# to — and worse, whichever of the parent and its worktree starts second loses
# the variant hostnames to the other.
if [ ! -f .git ] && [ ! -f hostshift.yaml ]; then
  echo "hostshift: warning: this is not a linked worktree and declares no" >&2
  echo "  hostshift.yaml, so its own hostnames are the ones the database holds and" >&2
  echo "  there is nothing to map. Run this in a worktree, or declare the hostnames" >&2
  echo "  the database really holds in hostshift.yaml." >&2
fi

# And what the checkout this worktree came from answers to.
#
# Those hostnames are the ones the *database* holds. `db:pull` search-replaced
# to the parent's hostname, not to the worktree's, and a worktree that gives
# itself a DDEV project of its own is by definition served at a hostname the
# database has never heard of. Asking `hostshift map` for this directory's map
# would build it against that served-at hostname: nothing to rewrite, every link
# still pointing at the parent, and `check` reporting the map injective and
# anchored. So when this is a linked worktree of a *different* DDEV project, its
# hostnames are the canonical side.
parent=""
parent_hosts=""
unreadable_parent=""
linked=""
common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
gitdir="$(git rev-parse --path-format=absolute --git-dir 2>/dev/null || true)"

# A linked worktree has a .git *file* pointing into the parent's .git directory,
# where a normal checkout has a .git directory. That is the reliable signal:
# when the parent has been moved or deleted `git rev-parse --git-common-dir`
# *fails* rather than naming an unreadable path, so testing its output alone
# read as "not a worktree at all" and skipped the parent path in silence — the
# map then had the worktree's own hostname as canonical, and because
# parent_hosts was empty the narrowing subtracted nothing, so the worktree kept
# claiming the parent's blog hostnames permanently rather than until a restart.
# A submodule has a .git file too, and its "parent" would be the superproject's
# modules directory — not a checkout, and warning about it is a false alarm.
# Only a linked worktree's gitdir points inside a .git/worktrees/ directory.
grep -q '/worktrees/' .git 2>/dev/null && linked=1
[ -n "$common" ] && [ "$common" != "$gitdir" ] && [ -d "$common" ] && linked=1

if [ -n "$linked" ] && [ -z "$common" ]; then
  unreadable_parent="$(sed -n 's/^gitdir: //p' .git 2>/dev/null | sed 's|/\.git/worktrees/.*||')"
  unreadable_parent="${unreadable_parent:-the checkout this worktree came from}"
elif [ -n "$linked" ]; then
  dir="$(dirname "$common")"
  ph="$(hostshift hosts -C "$dir" 2>/dev/null || true)"
  case "$ph" in
    # Nothing readable there. Distinct from the case below, and the two must not
    # be confused: this one is a problem and that one is not.
    #
    # A .ddev/config.yaml that is *present* but not parseable is the common
    # shape, and mid-rebase it is the common cause: conflict markers make the
    # YAML invalid, and "no DDEV config could be read there" then reads as
    # "the parent has no DDEV project", which sends the reader looking in the
    # wrong place entirely. Say which file, and what is in it.
    "") unreadable_parent="$dir"
        if [ -f "$dir/.ddev/config.yaml" ]; then
          if grep -q '^<<<<<<< ' "$dir/.ddev/config.yaml" 2>/dev/null; then
            unreadable_parent="$dir (its .ddev/config.yaml has unresolved conflict markers)"
          else
            unreadable_parent="$dir (its .ddev/config.yaml could not be parsed)"
          fi
        fi ;;
    # A repo that pins `name:` in its tracked config.yaml gives every worktree
    # the *same* DDEV project — same containers, same hostnames. There is nothing
    # to derive from elsewhere and nothing to subtract.
    "$hosts") : ;;
    *) parent="$dir"; parent_hosts="$ph" ;;
  esac
fi

if [ "$cmd" = "copy-db" ]; then
  [ -n "$parent" ] || {
    echo "hostshift: no parent checkout to copy from — this is not a linked worktree" >&2
    echo "  of a different DDEV project. Use \`ddev import-db\` or a fresh pull." >&2
    exit 2; }
  from="$(basename "$parent")"
  [ -f "$parent/.ddev/config.yaml" ] && n="$(sed -n 's/^name: *//p' "$parent/.ddev/config.yaml" | head -1)" && [ -n "$n" ] && from="$n"

  # Sharing the parent's database and copying it are different decisions, and
  # doing both is worse than pointless: the dump goes into this worktree's own
  # idle `db` container while the application goes on reading and writing the
  # parent's — and copy-db says "copied", exit 0. The developer who ran it
  # *specifically to stop writing to the parent* is told they succeeded, and
  # carries on activating plugins and uploading media into the checkout they
  # were protecting.
  #
  # Ask the container, not the files. This grepped four paths for the parent's
  # db hostname and missed `.ddev/.env.web`, which is DDEV's own documented
  # place for per-service environment — measured: DB_HOST=ddev-<parent>-db there,
  # the worktree live on the parent's database, and copy-db reported success.
  # `printenv` in the web container sees every mechanism that can set it,
  # including ones DDEV has not invented yet, and it is what `check` already does
  # for the same reason.
  #
  # Both, not either. The container is the truth when it is up, and it is down
  # exactly when the files are all there is — a project stopped mid-configuration
  # is the likeliest moment for someone to reach for copy-db. The file list gains
  # `.ddev/.env.*`, which is where the miss was.
  shared=""
  dbenv="$(ddev exec -s web printenv DB_HOST DATABASE_URL DB_URL 2>/dev/null || true)"
  case "$dbenv" in
    *"ddev-$from-db"*) shared="$(printf '%s\n' "$dbenv" | grep -F "ddev-$from-db" || true)" ;;
  esac
  if [ -z "$shared" ]; then
    shared="$(grep -rs 'ddev-'"$from"'-db' \
      .ddev/config.yaml .ddev/config.*.yaml .ddev/docker-compose.*.yaml \
      .ddev/.env .ddev/.env.* 2>/dev/null || true)"
  fi
  if [ -n "$shared" ]; then
    echo "hostshift: this worktree is configured to *use* $from's database:" >&2
    printf '%s\n' "$shared" | sed 's/^/    /' >&2
    echo "  Copying into it would write the dump to this worktree's own db" >&2
    echo "  container, which nothing reads, and report success. Remove that" >&2
    echo "  override and \`ddev restart\` first." >&2
    exit 2
  fi

  # It overwrites. Refuse to do that silently to a database that has something
  # in it — the caller may well have meant `ddev import-db`, or may be in the
  # wrong directory, and there is no undo.
  if [ -z "$force" ]; then
    tables="$(ddev exec -s web bash -c \
      "mysql -h db -udb -pdb -N -B -e \"select count(*) from information_schema.tables where table_schema='db'\"" \
      2>/dev/null | tail -1 | tr -dc '0-9' || true)"
    if [ -n "$tables" ] && [ "$tables" -gt 0 ] 2>/dev/null; then
      echo "hostshift: this worktree's database already has $tables table(s)." >&2
      echo "  Copying from $from replaces them, and there is no undo." >&2
      echo "  Pass --force if that is what you want." >&2
      exit 2
    fi
  fi

  echo "hostshift: copying the database from $from" >&2
  # --add-drop-database --databases, so this replaces rather than merges.
  # mysqldump|mysql on its own only drops the tables the dump contains, so a
  # worktree whose database came from an older pull kept everything the parent no
  # longer has — a removed blog's wp_N_* set, an uninstalled plugin's tables — and
  # was then not in the state the parent is in, which is the whole claim. The
  # refusal message promises a replace; this makes it true.
  ddev exec -s web bash -c "set -o pipefail; mysqldump --single-transaction --quick \
    --no-tablespaces --add-drop-database --databases db -h ddev-$from-db -udb -pdb \
    | mysql -h db -udb -pdb" || {
    # Not "the copy failed", full stop — that reads as "nothing happened", and
    # it is only true if the dump never started. --add-drop-database puts
    # `DROP DATABASE` at the top of the stream, so an interruption after that
    # point — the laptop sleeping, the parent stopped mid-copy — leaves this
    # database dropped and partially reloaded. Saying so is the difference
    # between re-running the command and debugging a site that is now missing
    # half its tables.
    echo "hostshift: the copy failed." >&2
    echo "  Is $from running? \`ddev start $from\`" >&2
    echo "  This worktree's database may be half-replaced: the dump drops it" >&2
    echo "  before reloading. Re-run with --force once $from is up." >&2
    exit 1; }
  echo "hostshift: copied. It still holds $from's hostnames, which is what" >&2
  echo "  hostshift maps — nothing else to do." >&2
  exit 0
fi

# hostshift.yaml, where a project has one, is a deliberate statement about which
# hostnames the database holds — usually because it names alias hostnames from
# other environments, or production ones the database was never search-replaced
# away from. Passing --from would override it.
map_args=()
if [ ! -f hostshift.yaml ] && [ -n "$unreadable_parent" ]; then
  # A linked worktree whose parent declares nothing readable. Falling through
  # silently is the failure this whole path exists to prevent: the map gets built
  # against the hostname the worktree is *served at*, every page loads, every
  # link stays wrong, and `check` calls it injective and anchored.
  echo "hostshift: warning: this is a worktree of $unreadable_parent, but no DDEV" >&2
  echo "  config could be read there, so the map falls back to this project's own" >&2
  echo "  hostnames. If the database came from that checkout it holds *its*" >&2
  echo "  hostnames, and nothing will be rewritten. Declare them in hostshift.yaml." >&2
fi
if [ ! -f hostshift.yaml ] && [ -n "$parent_hosts" ]; then
  # Said out loud, because "map from --from/--to" does not tell anyone which
  # checkout those origins came from, and that is the one thing worth knowing.
  echo "hostshift: canonical hostnames from $parent, whose database this shares" >&2
  while IFS= read -r h; do
    [ -n "$h" ] && map_args+=(--from "https://$h")
  done <<<"$parent_hosts"
fi

# The map is the binary's business; parse only what this needs from it.
variants="$(hostshift map --slug "$slug" "${map_args[@]+"${map_args[@]}"}" --variant-hosts \
  | paste -sd, -)"
[ -n "$variants" ] || { echo "hostshift produced no map — run 'hostshift check'" >&2; exit 2; }

# Nothing anywhere checks that two projects do not claim the same hostname —
# DDEV validates hostname syntax per project and no more, and traefik resolves a
# tie by rule length rather than complaining. Two branches whose slugs collide
# therefore give two worktrees identical VIRTUAL_HOST entries, and one of them
# silently serves the other's code at the URL its author is reviewing. The
# 30-character truncation makes that likelier, not rarer: PROJ-123-fix-cart and
# proj/123/fix-cart already collide, as does any pair sharing a 30-character
# prefix. Checking is cheap — every configured project leaves its variants in
# .ddev/.env — so check.
here="$(pwd -P)"
for other in ../*/.ddev/.env; do
  [ -f "$other" ] || continue
  odir="$(cd "$(dirname "$(dirname "$other")")" && pwd -P)"
  [ "$odir" = "$here" ] && continue
  # No `| head -1`: this script runs under `set -o pipefail`, and a head that
  # exits after one line SIGPIPEs whatever is still writing, failing the whole
  # pipeline. It is timing-dependent, so it passes on a fast small write and
  # fails on a slow one — sed that stops at the first match instead.
  ovar="$(sed -n '/^HOSTSHIFT_VARIANTS=/{s///p;q;}' "$other")"
  [ -n "$ovar" ] || continue
  for v in $(printf '%s' "$variants" | tr ',' ' '); do
    case ",$ovar," in *",$v,"*)
      echo "hostshift: warning: $odir already claims $v." >&2
      echo "  Two projects answering to one hostname is not an error anywhere in DDEV;" >&2
      echo "  the router picks one and the other is silently unreachable. Pass --slug to" >&2
      echo "  choose a different name." >&2
      # The warning is right either way; the *refusal* is not. A worktree that
      # was `ddev delete`d but whose directory stayed still has its .ddev/.env,
      # and `git worktree remove` refuses while untracked files are present, so
      # the directory staying is the common case rather than the odd one. That
      # made `check` exit 2 — failing the post-start hook on every single start —
      # over a claim nothing was making, while routing was perfectly correct, and
      # the advice to pass --slug was wrong for that case.
      #
      # So only a *live* claim is fatal. If the rival is not running there is
      # nothing to lose a routing tie to today.
      oname="$(basename "$odir")"
      if [ -f "$odir/.ddev/config.yaml" ]; then
        n="$(sed -n 's/^name: *//p' "$odir/.ddev/config.yaml" | sed -n 1p)"
        [ -n "$n" ] && oname="$n"
      fi
      if [ "$(docker inspect "ddev-$oname-web" --format '{{.State.Running}}' 2>/dev/null || true)" = "true" ]; then
        claimed="$v"
      else
        echo "  ($oname is not running, so nothing is serving it right now.)" >&2
      fi
      break 2 ;;
    esac
  done
done


# web keeps this project's own hostnames, minus the variants and minus the
# parent's. DDEV puts every additional hostname on web's VIRTUAL_HOST, so
# without narrowing it web and hostshift both claim the variants and the router
# picks web — WordPress then sees a variant host, fails to match
# wp_blogs.domain, and redirects to wp-signup.php.
web=""
while IFS= read -r h; do
  [ -n "$h" ] || continue
  case ",$variants," in *",$h,"*) continue ;; esac
  case "
$parent_hosts
" in *"
$h
"*) continue ;; esac
  web="${web:+$web,}$h"
done <<<"$hosts"

# The map the proxy cannot work out for itself.
#
# The compose service mounts ${DDEV_APPROOT}:/project — this worktree, and only
# this worktree. The checkout it branched from is not in the container and never
# will be, so the canonical hostnames, which live over there, are unknowable
# inside it. `proxy -C /project` on a repo with no hostshift.yaml therefore built
# its map from the worktree's own DDEV config, where a missing `name:` defaults
# to the *directory basename* — which inside the container is literally
# "project". The proxy came up mapping https://project.ddev.site, the router sent
# it wt-a--transformerco.ddev.site, and every request 421'd.
#
# So it is resolved here, on the host, where the parent checkout is readable, and
# handed over. Only when there is no hostshift.yaml: that file *is* mounted, it
# carries aliases a canonical=variant list cannot express, and the container
# reads it correctly.
hsmap=""
if [ ! -f hostshift.yaml ]; then
  # Repeated --from/--to, not `--map c=v,c=v`. Comma-separated --map is a flag
  # form this branch added, and the image is :latest: the published binary splits
  # the whole string on its first `=`, so a two-site map came out as one site
  # whose variant host was "wt-a--acme.ddev.site,https" and every variant 421'd —
  # while `ddev start`, `ddev hostshift check` and `hostshift map` on the host all
  # reported success. --from/--to is index-aligned and repeatable and always was,
  # so it works against the image already published as well as a current one.
  #
  # The whole flag sequence, not just its value: docker-compose's string command
  # form drops an argument that expands to nothing, so empty means no map flags
  # at all — which is right when a hostshift.yaml is mounted.
  hsmap=""
  while IFS='=' read -r c v; do
    [ -n "$c" ] || continue
    hsmap="${hsmap:+$hsmap }--from $c --to $v"
  done <<<"$(hostshift map --slug "$slug" "${map_args[@]+"${map_args[@]}"}" --pairs)"
  [ -n "$hsmap" ] || { echo "could not resolve a map to hand the proxy" >&2; exit 2; }
fi

# DDEV derives `name` from the directory but not additional_hostnames, so a
# worktree inherits the parent's extra hostnames verbatim and registers them as
# its own. traefik has no cross-project uniqueness check — DDEV's own
# ValidateConfig only checks hostname *syntax* — and it resolves the tie by rule
# length. A worktree's directory name is the parent's plus a suffix, so its rule
# is always the longer one: the worktree wins every shared hostname, every time,
# and `ddev start` says nothing.
#
# HOSTSHIFT_WEB_HOSTS below hands them back at the next restart. The window
# between the worktree's first `ddev start` and that restart is real, though, and
# during it the *parent's* blog is served by the worktree. This is the one moment
# anyone can act on it. Upstream: ddev/ddev#5486, reopened for git worktrees.
# Not on `check`. The note is a static intersection of the two projects'
# declared hostnames, so it was true when init said it and false ever after —
# and the post-start hook printed it on every start, including the restart that
# had just handed those hostnames back to the parent. Four lines of "until
# `ddev restart`, those serve this worktree" from the hook of that very restart.
if [ -n "$parent_hosts" ] && [ "$cmd" != "check" ]; then
  shared=""
  while IFS= read -r h; do
    [ -n "$h" ] || continue
    case "
$parent_hosts
" in *"
$h
"*) shared="${shared:+$shared, }$h" ;; esac
  done <<<"$hosts"
  if [ -n "$shared" ]; then
    echo "hostshift: note: this worktree also registered $shared," >&2
    echo "  inherited verbatim from the tracked .ddev/config.yaml — DDEV derives the" >&2
    echo "  project name from the directory but not the additional hostnames. Until" >&2
    echo "  \`ddev restart\`, those serve this worktree rather than $(basename "$parent")." >&2
  fi
fi

# One variable, not two. `--slug` and the map args are mutually exclusive by
# construction: internal/config returns early on --from/--to, so the slug is
# never read once a map is given — and when a mounted hostshift.yaml supplies the
# canonical side, the slug is the only way to derive the variant. Shipping both
# meant one of them was always dead, and the multisite example showed an empty
# HOSTSHIFT_MAP_ARGS= line that reads like a bug.
args="${hsmap:---slug $slug}"

# #ddev-silent-no-warn, because DDEV otherwise prints a four-line "Custom
# configuration detected" block naming this file on every single start. It is a
# legal dotenv comment and DDEV documents the marker in that very message.
env_out="#ddev-silent-no-warn
HOSTSHIFT_ARGS=$args
HOSTSHIFT_VARIANTS=$variants
HOSTSHIFT_WEB_HOSTS=$web"


# `hostshift check` on its own is the wrong question in a worktree, and answers
# it confidently: run without --from it resolves layer 1 against *this* checkout,
# reports the map injective and anchored, and exits 0 — for a map whose canonical
# hostname appears nowhere in the database and which the proxy never sees. It is
# also what the README, this add-on's own post-install text and the proxy's 421
# body all tell you to run.
#
# So the DDEV-shaped question is asked here, where knowing what a worktree is is
# allowed: check the map that would be deployed, and whether what *is* deployed
# still matches it.
# A worktree that needs to *write* — activate a plugin, run a migration, upload
# media — needs a database of its own rather than the parent's. The fastest
# source is the parent itself: every DDEV container is on ddev_default, so the
# worktree's web container can reach the parent's db container by name and stream
# one into the other. No dump on disk, no compression, no production round trip,
# and it is the state you are already working against.
#
# It does not touch hostnames. Whatever is copied still holds the parent's, which
# is exactly why hostshift is needed afterwards just as much as before.
if [ "$cmd" = "check" ]; then
  hostshift check --slug "$slug" "${map_args[@]+"${map_args[@]}"}" || exit $?

  if [ ! -f .ddev/.env ]; then
    echo "hostshift: nothing deployed yet — run \`ddev hostshift init\`" >&2
    exit 2
  fi

  # Is the file current? The whole block, not one variable of it: a renamed
  # worktree drifts only in HOSTSHIFT_WEB_HOSTS, a parent that gains a blog only
  # in HOSTSHIFT_VARIANTS, and a hostshift.yaml appearing only in HOSTSHIFT_ARGS
  # — where the deployed flat map goes on beating the file, so its aliases
  # silently never rewrite.
  deployed="$(grep -e '^HOSTSHIFT_' -e '^#ddev-silent-no-warn' .ddev/.env || true)"
  if [ "$deployed" != "$env_out" ]; then
    echo "hostshift: .ddev/.env is out of date. It says" >&2
    printf '%s\n' "${deployed:-  nothing}" >&2
    echo "  and this project now resolves to" >&2
    printf '%s\n' "$env_out" >&2
    if [ -n "$unreadable_parent" ]; then
      echo "  Not \`ddev hostshift init\` — the map above was built from this" >&2
      echo "  worktree's own hostnames because $unreadable_parent could not be" >&2
      echo "  read, and deploying it would rewrite nothing and take the parent's" >&2
      echo "  hostnames with it. Fix that checkout first." >&2
    else
      echo "  Run \`ddev hostshift init\`, which restarts to pick it up." >&2
    fi
    exit 2
  fi

  # And is the file what is *running*? Everything above compares the file to a
  # recomputation of the file, which cannot see the commonest failure there is:
  # `init` without the `ddev restart` it just told you to run. It reported
  # success with every container stopped, and after a slug change while the old
  # slug was still being served. So ask the container.
  # DDEV_SITENAME is what DDEV itself calls this project, and it hands it to
  # host commands. Re-deriving it here read .ddev/config.yaml only, while DDEV
  # merges config.*.yaml — and config.*.local.yaml is the natural place for a
  # worktree to name itself, so a correctly configured worktree was told its
  # proxy was not running, on every single `ddev start`.
  name="${DDEV_SITENAME:-$(basename "$(pwd -P)")}"
  # .State.Running as well as the env: docker keeps Config.Env for a container
  # that has exited, and the compose service is `restart: "no"`, so a proxy that
  # crashed stays down — and reporting its *configured* hostnames as served
  # certified a total outage as healthy while every variant 502'd.
  state="$(docker inspect "ddev-$name-hostshift" \
    --format '{{.State.Running}}{{"\n"}}{{range .Config.Cmd}}{{.}} {{end}}{{"\n"}}{{range .Config.Env}}{{println .}}{{end}}' \
    2>/dev/null || true)"
  alive="$(printf '%s' "$state" | sed -n '1p')"
  cmd_running="$(printf '%s' "$state" | sed -n '2p')"
  running="$(printf '%s' "$state" | sed -n '/^VIRTUAL_HOST=/{s///p;q;}')"
  if [ -z "$alive" ]; then
    echo "hostshift: no ddev-$name-hostshift container. \`ddev restart\` to serve" >&2
    echo "  $variants" >&2
    exit 2
  fi
  if [ "$alive" != "true" ]; then
    echo "hostshift: the proxy container has exited, so every variant 502s." >&2
    echo "  \`ddev logs -s hostshift\` for why, then \`ddev restart\`." >&2
    exit 2
  fi
  if [ -z "$running" ]; then
    echo "hostshift: the proxy is running but answers on nothing —" >&2
    echo "  its VIRTUAL_HOST is empty. \`ddev hostshift init && ddev restart\`." >&2
    exit 2
  fi
  if [ "$running" != "$variants" ]; then
    echo "hostshift: the running proxy answers on" >&2
    echo "  $running" >&2
    echo "  but .ddev/.env now says" >&2
    echo "  $variants" >&2
    echo "  Run \`ddev restart\`." >&2
    exit 2
  fi

  # VIRTUAL_HOST says which hostnames reach the proxy. It says nothing about the
  # map the proxy was started with — and a proxy that is running, routed, and
  # 421ing every hostname it is routed for was reported as healthy. That is the
  # failure this file has warned about twice (`--map ""`, then a comma-separated
  # `--map`), and it is what an upgrade produces when the two halves of the
  # add-on disagree about a variable name.
  case " $cmd_running " in
    *" $args "*) ;;
    *) echo "hostshift: the proxy is running with a different map than .ddev/.env" >&2
       echo "  says. It was started with:" >&2
       echo "    $cmd_running" >&2
       echo "  and .ddev/.env now asks for:" >&2
       echo "    $args" >&2
       echo "  Run \`ddev restart\`." >&2
       exit 2 ;;
  esac

  if [ -n "$claimed" ]; then
    echo "hostshift: refusing to call this healthy — $claimed is claimed by" >&2
    echo "  another project too, and the router serves whichever it prefers." >&2
    exit 2
  fi

  # The map itself, not just the command line that asked for it.
  #
  # When the container resolves its own map from a mounted hostshift.yaml, the
  # command line is `--slug X` and stays `--slug X` however the file changes — so
  # editing hostshift.yaml and not restarting left `check` printing "hostshift is
  # serving" while the new alias rewrote nothing. Two attempts at closing this
  # were worse than the gap (a checksum at init time called a correctly restarted
  # project stale; a file mtime against the container's was unreliable across
  # platforms), and both were guessing at something the proxy states outright:
  # it prints its resolved map to stderr at startup, and `docker logs` still has
  # it. Comparing that against `hostshift map` here is exact, needs no recorded
  # state, and both sides render through the same Map.String().
  #
  # Best-effort by design. A rotated or truncated log yields no pair lines and is
  # not evidence of drift, so it says nothing rather than crying wolf.
  running_map="$(docker logs "ddev-$name-hostshift" 2>&1 \
    | sed -n 's/^\(.*[[:space:]]\)\{0,1\}\(https:\/\/[^[:space:]]*[[:space:]]*->[[:space:]]*https:\/\/[^[:space:]]*\)$/\2/p' \
    | tr -s ' ' | sort -u || true)"
  if [ -n "$running_map" ]; then
    want_map="$(hostshift map --slug "$slug" "${map_args[@]+"${map_args[@]}"}" 2>/dev/null \
      | sed -n 's/^\(.*[[:space:]]\)\{0,1\}\(https:\/\/[^[:space:]]*[[:space:]]*->[[:space:]]*https:\/\/[^[:space:]]*\)$/\2/p' \
      | tr -s ' ' | sort -u || true)"
    if [ -n "$want_map" ] && [ "$running_map" != "$want_map" ]; then
      echo "hostshift: the proxy is running a different map than this checkout" >&2
      echo "  now resolves to. It started with:" >&2
      printf '%s\n' "$running_map" | sed 's/^/    /' >&2
      echo "  and hostshift.yaml/DDEV config now give:" >&2
      printf '%s\n' "$want_map" | sed 's/^/    /' >&2
      echo "  Run \`ddev restart\`." >&2
      exit 2
    fi
  fi

  printf '\n  hostshift is serving:\n' >&2
  printf '    https://%s\n' $(printf '%s' "$variants" | tr ',' ' ') >&2
  printf '\n' >&2
  exit 0
fi


if [ "$cmd" = "init" ] && [ -n "$unreadable_parent" ] && [ ! -f hostshift.yaml ]; then
  echo "hostshift: refusing to write a map built from this worktree's own" >&2
  echo "  hostnames. $unreadable_parent could not be read, so the canonical side" >&2
  echo "  would be the hostname this worktree is *served at* — nothing would be" >&2
  echo "  rewritten — and web would keep the parent's hostnames, which both" >&2
  echo "  projects would then claim. Fix that checkout, or declare the hostnames" >&2
  echo "  the database really holds in hostshift.yaml." >&2
  exit 2
fi

# The production hostnames are already declared, in hostshift.yaml's canonical
# and aliases. Writing them a second time by hand into a compose file is how the
# two come to disagree — and the failure of disagreeing is wp-cron POSTing to the
# client's live site from a box holding a production database. Same shape as
# wp-cli: it prints, you redirect.
if [ "$cmd" = "loopback" ]; then
  # Canonical *and* aliases: an alias is a production hostname the content may
  # still name, so leaving it out is the same leak with a different spelling.
  hosts_out="$(hostshift map --slug "$slug" "${map_args[@]+"${map_args[@]}"}" \
    --canonical-hosts | sort -u)"
  # Off-box means "not one this DDEV project answers to". The project's own TLD
  # is the tail of its primary hostname, which `hostshift hosts` prints first.
  tld="$(printf '%s\n' "$hosts" | head -1 | cut -d. -f2-)"
  offbox="$(printf '%s\n' "$hosts_out" | grep -v "\.${tld:-ddev.site}\$" || true)"
  if [ -z "$offbox" ]; then
    echo "hostshift: every canonical hostname is a local DDEV one, so the" >&2
    echo "  application's own internal requests already stay on this machine." >&2
    echo "  Nothing to contain." >&2
    exit 0
  fi
  echo "#ddev-silent-no-warn"
  echo "# generated by \`ddev hostshift loopback\` from hostshift.yaml — do not edit"
  echo "services:"
  echo "  web:"
  echo "    extra_hosts:"
  printf '      - "%s:127.0.0.1"\n' $offbox
  exit 0
fi

if [ "$cmd" = "env" ]; then
  printf '%s\n' "$env_out"
  exit 0
fi

# wp-cli.local.yml *replaces* wp-cli.yml rather than merging with it — measured
# with WP-CLI 2.12.0, where a file carrying only `url:` lost `path:`, `require:`
# and every alias, and WP-CLI then could not find the installation at all. So
# the whole config goes through with a root url added.
#
# Appending a top-level key is all that takes, and it beats a YAML round trip:
# the original formatting, key order and comments survive untouched. This is
# WordPress's business, not the proxy's — hostshift does not know what a CMS is.
#
# Two details make the difference between valid YAML and a parse error. A
# wp-cli.yml with no trailing newline (what printf and several editors produce)
# glues `url:` onto its last line — "require: wp-cli.phpurl: https://…". And a
# wp-cli.yml that already has a root `url:` gets it twice, which yaml.v3 rejects
# outright as a duplicate key.
if [ "$cmd" = "wp-cli" ]; then
  # Likewise no `| head -1 | cut`: hostshift would be killed by SIGPIPE mid-write
  # and pipefail would take the exit code, so `wp-cli` failed with "no canonical
  # origin in the map" on Linux and passed on macOS.
  canonical="$(hostshift map --slug "$slug" "${map_args[@]+"${map_args[@]}"}" --pairs \
    | sed -n '1s/=.*//p')"
  [ -n "$canonical" ] || { echo "no canonical origin in the map" >&2; exit 2; }
  echo "# generated by \`ddev hostshift wp-cli\` — do not commit"
  if [ -f wp-cli.yml ]; then
    sed -e '/^url:[[:space:]]/d' wp-cli.yml
    echo
  fi
  echo "url: $canonical"
  exit 0
fi

# One file, not two. Registering the variants in additional_hostnames was
# believed to be what put them in the mkcert certificate's SAN — and it is not.
# DDEV builds that SAN list from the project's hostnames *plus every
# VIRTUAL_HOST entry across all compose services* (pkg/ddevapp/traefik.go,
# detectAppRouting: "There can possibly be VIRTUAL_HOST entries which are not
# configured hostnames"), unchanged from v1.23 to v1.25. The compose service
# already puts HOSTSHIFT_VARIANTS in VIRTUAL_HOST, so the certificate already
# covers them. Measured on v1.25.2 with no config.hostshift.local.yaml on disk
# at all: the served cert carried DNS:wt-a--shop.acme.ddev.site — three labels,
# never registered — and openssl verified it against the mkcert root, return
# code 0.
#
# The two inputs do different jobs, which the old comment conflated:
# additional_hostnames drives /etc/hosts, the cert SANs and `ddev describe`;
# VIRTUAL_HOST drives the traefik routers *and* the cert SANs. So VIRTUAL_HOST
# is a strict superset of what this needs, and the generated file was redundant.
#
# Not writing it is worth more than the file it saves. It was a
# .ddev/config.*.yaml, so hostshift read it back as input on the next run — the
# variants returned as canonical hosts, got variants of their own, and
# additional_hostnames grew without bound. That whole hazard, and the marker
# that suppressed it, existed only because of this file.
#
# Caveat, untested: on a custom project_tld that does not resolve publicly,
# additional_hostnames is still what drives /etc/hosts, and a VIRTUAL_HOST-only
# name would get a certificate but no hosts entry. Every project in the fleet is
# on ddev.site, whose wildcard resolves at any depth.
if [ -n "$dry_run" ]; then
  echo "# .ddev/.env" ; printf '%s\n' "$env_out"
  hostshift map --slug "$slug" "${map_args[@]+"${map_args[@]}"}" >&2
  echo "hostshift: --dry-run, nothing written" >&2
  exit 0
fi

# Merged, not truncated: .ddev/.env is a project file that may hold something
# else already.
touch .ddev/.env
# In .ddev/ so the mv is a rename on one filesystem rather than a copy+unlink
# across two, which is not atomic — a concurrent compose read must never catch
# this half-written and see an empty VIRTUAL_HOST.
tmp="$(mktemp .ddev/.env.XXXXXX)"
trap 'rm -f "$tmp"' EXIT
# cp -p first, then truncate: that gives the temp file the mode the real one
# already had, and redirection keeps it. .ddev/.env is where DDEV documents
# putting project env vars, credentials included, so a developer who chmod 600'd
# it meant it.
cp -p .ddev/.env "$tmp"
{ grep -v -e '^HOSTSHIFT_' -e '^#ddev-silent-no-warn' .ddev/.env || true
  printf '%s\n' "$env_out"; } > "$tmp"
mv "$tmp" .ddev/.env

echo "hostshift: wrote .ddev/.env" >&2
hostshift map --slug "$slug" "${map_args[@]+"${map_args[@]}"}" >&2

# And pick it up. init always leaves the project stale — that is what it is for —
# so ending with the restart removes the step this file elsewhere calls the
# commonest failure there is: init without the `ddev restart` it just told you to
# run. env, wp-cli and --dry-run all exit above this line and never restart.
# Only when actually invoked through `ddev hostshift` — DDEV sets DDEV_APPROOT
# for a host command, and nothing else does. Run directly, from a test or by
# hand, init stays what it says on the tin: it writes a file.
if [ -n "${DDEV_APPROOT:-}" ] && command -v ddev >/dev/null; then
  echo "hostshift: restarting to pick it up" >&2
  exec ddev restart
fi
echo "hostshift: now run \`ddev restart\`" >&2
