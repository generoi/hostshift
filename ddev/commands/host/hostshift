#!/usr/bin/env bash
#ddev-generated
## Description: configure hostshift for this DDEV project
## Usage: hostshift [init|check|copy-db|loopback|env|wp-cli] [--slug NAME]
## Example: "ddev hostshift init"
##
## Scaffolding a DDEV project is opinionated work, and this is where it is
## allowed to be. The hostshift binary maps origins; it can *read* this
## project's declared hostnames as one source for that map, and it deliberately
## does not write .ddev/ files, guess slugs from branches, or decide which
## hostnames `web` should keep. A binary with a `ddev init` subcommand would be
## a tool for one shop; this command is the shop.
##
## #ddev-generated, and it has to be. Without that marker `ddev add-on get`
## refuses to overwrite this file, so an upgrade installs a new compose file
## beside the old command — and the two halves disagree about the variable names
## they pass between them. Renaming HOSTSHIFT_SLUG/HOSTSHIFT_MAP_ARGS to
## HOSTSHIFT_ARGS did exactly that: init wrote the old names, compose read the
## new one, the proxy started with its inert default and every variant 421'd,
## with `init`, `restart` and `check` all reporting success.
##
## The cost is that a local edit here is lost on the next `ddev add-on get`.
## That is the right trade for a file whose whole job is to stay in step with the
## compose file it ships beside. The loopback override is the opposite case and
## deliberately carries no marker.
##
## Needs the hostshift binary on PATH. Everything generic comes from it — the
## map, the variants, the hostnames a checkout declares — and everything
## DDEV-shaped is assembled here.

set -euo pipefail

# Every path below is relative to the project root, and `ddev` may be run from
# anywhere inside the project.
[ -n "${DDEV_APPROOT:-}" ] && cd "$DDEV_APPROOT"

# Usage, not init, when no subcommand is given. `init` writes .ddev/.env and
# restarts every container, so a developer reaching for the usage text took
# their project down instead — and for a six-subcommand tool the safe default is
# the one that changes nothing. The post-start hook and every documented
# invocation name their subcommand explicitly.
cmd="${1:-}"; shift || true
# Every flag, because --slug-from-branch is the documented way back from a
# pinned slug and appeared in neither the usage line nor --help — its only
# mention anywhere was one line init prints, which is also the only mention of
# the pinning itself.
usage() {
  cat <<'USAGE'
usage: ddev hostshift <command> [flags]

  init                write .ddev/.env and restart to pick it up
  check               is what is deployed still what this checkout resolves to?
  copy-db             replace this worktree's database with the parent's
  loopback            pin the canonical hostnames to 127.0.0.1 inside web
  env                 print what init would write
  wp-cli              write wp-cli.local.yml

  --slug NAME         name this worktree's hostnames; recorded, and it sticks
  --slug-from-branch  forget a recorded slug and follow the branch again
  --dry-run, -n       say what would happen, write nothing
  --force             copy-db: overwrite a database that has tables
  --quiet, -q         say nothing when there is nothing to check
USAGE
}

# Usage is printed here, after the function exists, rather than defaulting `cmd`
# to `init` — which writes .ddev/.env and restarts every container, so a
# developer reaching for the usage text took their project down instead. The
# post-start hook and every documented invocation name their subcommand.
if [ -z "$cmd" ]; then
  usage
  exit 0
fi

slug=""
slug_explicit=""
forget_slug=""
branch=""
dry_run=""
force=""
quiet=""
claimed=""
while [ $# -gt 0 ]; do
  case "$1" in
    --slug) slug="${2:?--slug needs a value}"; slug_explicit=1; shift 2 ;;
    # Both spellings agree. `--slug ""` was refused and `--slug=` was not, so
    # the empty value left slug_explicit set, the branch derivation filled the
    # slug in, and a *branch-derived* name was written to .ddev/.env as a chosen
    # one — pinning the naming forever, with nothing said and --slug-from-branch
    # the only way back.
    --slug=*) slug="${1#*=}"
       [ -n "$slug" ] || { echo "--slug needs a value" >&2; exit 2; }
       slug_explicit=1; shift ;;
    # The way back. A recorded slug outranks the branch — that is the point of
    # recording it — so without this the only way to return to branch-derived
    # naming is to hand-edit .ddev/.env.
    --slug-from-branch) forget_slug=1; shift ;;
    --dry-run|-n) dry_run=1; shift ;;
    --quiet|-q) quiet=1; shift ;;
    --force) force=1; shift ;;
    # Silently discarding an unknown flag is how `--dry-run` came to write the
    # files it was passed to prevent.
    *) echo "unknown argument: $1" >&2
       usage >&2
       exit 2 ;;
  esac
done

case "$cmd" in
  init|check|copy-db|loopback|env|wp-cli) ;;
  -h|--help|help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

# The post-start hook runs `check` on every start. Between `ddev add-on get` and
# `ddev hostshift init` — and permanently, for anyone who installed the add-on
# and never used it — there is nothing to check, and saying so in nine lines plus
# a `Task failed` is how an add-on stops being inert until it is configured.
#
# $HOSTSHIFT_HOOK, not a flag, and that is not a style choice.
# `config.hostshift.yaml` carries #ddev-generated so `ddev add-on get` replaces
# it on upgrade. This file only gained that marker *after* v0.1.0, so DDEV
# refuses to replace it — an upgraded project runs the new hook against the old
# command, and the old parser exits 2 on any flag it does not know. Measured on a
# real upgrade: `unknown argument: --quiet`, `Task failed`, `Successfully
# started`. The proxy kept serving, so nothing looked wrong, and the post-start
# check was dead from then on: every later drift — a renamed directory, a changed
# branch, a stale .env, a crashed proxy, a hijacked hostname — went unreported on
# exactly the projects that had been running longest.
#
# `bash -c` runs the hook line (ddev pkg/ddevapp/task.go, ExecHostTask.Execute),
# so an environment prefix is a plain assignment there, and a parser that only
# reads "$@" cannot trip over it. The rule the compose file states — anything
# added must work against what is already deployed — covers the hook line too.
#
# Only this short-circuit is gated. `ddev hostshift check` typed by a person on a
# project with no configuration is a question that deserves an answer, and it
# still gets one.
#
# `[ ! -e ]` or readable-and-empty, not `grep -qs`. -s swallows the difference
# between "no HOSTSHIFT_ line" and "cannot read the file", so a fully configured
# project whose .ddev/.env had lost its read permission reported healthy on every
# start — the one file the whole check is about, silently unread.
if [ "$cmd" = "check" ] && { [ -n "$quiet" ] || [ -n "${HOSTSHIFT_HOOK:-}" ]; }; then
  if [ ! -e .ddev/.env ]; then
    # Inert, but not silent in the one case where installing has already done
    # harm. `ddev add-on get` tells you to run `ddev restart`, and in a linked
    # worktree that restart registers every hostname inherited from the parent's
    # *tracked* config.yaml — a multisite's blog hostnames included — on this
    # project's web, where the router prefers it over the parent. The parent's
    # blog is then served by an empty database, `ddev describe` on the parent
    # still lists the URL, and the moment the add-on could have said so is the
    # moment it created the hazard.
    #
    # Cheap: the .git file names the parent, and the question is only whether it
    # declares extra hostnames. No map, no binary.
    if grep -q '/worktrees/' .git 2>/dev/null; then
      pdir="$(sed -n 's/^gitdir: //p' .git 2>/dev/null | sed 's|/\.git/worktrees/.*||')"
      if [ -n "$pdir" ] && grep -qs '^additional_hostnames:' "$pdir/.ddev/config.yaml"; then
        echo "hostshift: installed here but not configured, and this is a worktree of" >&2
        echo "  a project that declares additional_hostnames. Until you run" >&2
        echo "  \`ddev hostshift init\`, this worktree also answers to those, and the" >&2
        echo "  router prefers it over $(basename "$pdir") for any they share." >&2
      fi
    fi
    exit 0
  elif [ ! -r .ddev/.env ]; then
    echo "hostshift: .ddev/.env exists but cannot be read, so nothing here can be" >&2
    echo "  checked. \`chmod u+r .ddev/.env\`." >&2
    exit 2
  elif ! grep -q '^HOSTSHIFT_' .ddev/.env; then
    exit 0
  fi
fi

command -v hostshift >/dev/null || {
  echo "hostshift is not on PATH — https://github.com/generoi/hostshift" >&2; exit 1; }

# A worktree exists to hold a branch, so the branch is the slug unless told
# otherwise. Guessing this is exactly the kind of opinion the binary should not
# carry and a project-level command should.
#
# LC_ALL=C because the pipeline works on bytes: under a UTF-8 locale BSD sed
# aborts with "RE error: illegal byte sequence" on a branch named
# feature/käyttöliittymä, and en_US.UTF-8 is the macOS default in a Finnish
# shop. The trim runs after the truncation as well as before it, or a slug cut
# at 30 characters can end in a hyphen and derive "…abc---site.ddev.site".
# copy-db maps nothing, so it needs no slug — and refusing to copy a database
# because the branch name has no letters in it, or because HEAD is detached
# during a rebase, is a refusal with no reason behind it.
# A slug recorded by `init --slug` outranks the branch, for every subcommand
# that did not get one on the command line. Without this, `check` re-derived from
# the branch and called a correct deployment stale forever, and `init` run as the
# advice said reverted the choice.
if [ -z "$slug" ] && [ -z "$forget_slug" ] && [ "$cmd" != "copy-db" ]; then
  # HOSTSHIFT_SLUG_CHOSEN, not HOSTSHIFT_SLUG. v0.1.0's init wrote
  # `HOSTSHIFT_SLUG=$slug` *unconditionally* — for a slug derived from the
  # branch exactly as for one that was passed — so reading that name as a
  # deliberate choice pinned the naming on every project that ever ran v0.1.0,
  # which by this add-on's own history is where the longest-running pilots are.
  # It then announced "keeping the slug you chose" for a name nobody chose, on a
  # branch that may no longer exist. A name v0.1.0 never wrote cannot be
  # misread.
  slug="$(sed -n '/^HOSTSHIFT_SLUG_CHOSEN=/{s///p;q;}' .ddev/.env 2>/dev/null || true)"
  if [ -n "$slug" ]; then
    slug_explicit=1
    # Said out loud on init, because init is where a developer would expect a
    # bare invocation to re-derive, and silently keeping the old name is the
    # kind of helpfulness that reads as a bug.
    [ "$cmd" = "init" ] && echo "hostshift: keeping the slug you chose, $slug." \
      "\`--slug NAME\` to change it, \`--slug-from-branch\` to go back to the branch." >&2
  fi
fi

if [ -z "$slug" ] && [ "$cmd" != "copy-db" ]; then
  branch="$(git symbolic-ref --short HEAD 2>/dev/null || true)"
  # Detached HEAD is ordinary — a rebase, a bisect, a checked-out tag — and it
  # must not stop `check`, which the post-start hook runs on every start. The
  # deployed slug is right there in .ddev/.env.
  if [ -z "$branch" ] && [ "$cmd" = "check" ]; then
    # Any slug will do on the --from/--to path, where it is never read; on the
    # --slug path the deployed one is in .ddev/.env. Either way `check` must not
    # refuse during a rebase, a bisect or a checked-out tag — the hook runs it on
    # every start, and refusing means the staleness check silently stops running
    # for the duration.
    # Two shapes to recover from, and reading only the first is why this has
    # shipped broken twice: HOSTSHIFT_ARGS is `--slug X` only when a
    # hostshift.yaml is present. On the README's headline path it is
    # `--from … --to …`, and the deployed slug is the prefix of the first
    # variant — wt-a--acme.ddev.site — which is present in both shapes.
    slug="$(sed -n '/^HOSTSHIFT_ARGS=--slug /{s///p;q;}' .ddev/.env 2>/dev/null)"
    if [ -z "$slug" ]; then
      slug="$(sed -n '/^HOSTSHIFT_VARIANTS=/{s///p;q;}' .ddev/.env 2>/dev/null \
        | cut -d, -f1 | sed -n 's/--.*//p')"
    fi
    slug="${slug:-wt}"
  fi
  [ -n "$branch" ] || [ -n "$slug" ] || { echo "no git branch here — pass --slug" >&2; exit 2; }
fi

# Derive from the branch only when nothing above supplied one — the recovered
# slug used to be overwritten here two lines after it was found, which is why
# the detached-HEAD fallback never worked.
if [ -z "$slug" ] && [ -n "$branch" ]; then
  slug="$(printf '%s' "$branch" \
    | LC_ALL=C tr '[:upper:]' '[:lower:]' \
    | LC_ALL=C sed -e 's/[^a-z0-9]\{1,\}/-/g' \
    | LC_ALL=C cut -c1-30 \
    | LC_ALL=C sed -e 's/^-\{1,\}//' -e 's/-\{1,\}$//')"
  [ -n "$slug" ] || {
    echo "the branch $branch has no letters or digits to make a hostname label from — pass --slug" >&2
    exit 2; }
  echo "hostshift: slug \"$slug\", from the git branch $branch" >&2
fi

case "$slug" in
  *[!a-z0-9-]*|-*|*-)
    echo "hostshift: slug \"$slug\" is not a hostname label — use lowercase letters," >&2
    echo "  digits and hyphens, not starting or ending with one. It becomes part of a" >&2
    echo "  hostname and of the proxy's command line, where a space, quote, \$, ; or ," >&2
    echo "  silently truncates or corrupts the map." >&2
    exit 2 ;;
esac

# What this project answers to.  `hostshift hosts` reads the DDEV config with
# its config.*.yaml override merging — parsing that here would be the place the
# careful parts get lost.
hosts="$(hostshift hosts)"

# In the checkout a worktree branches *from*, there is no canonical/variant
# distinction to make: its own hostnames are the ones the database holds. Running
# init here points web at nothing and hands the variants to a proxy nobody routes
# to — and worse, whichever of the parent and its worktree starts second loses
# the variant hostnames to the other.
if [ ! -f .git ] && [ ! -f hostshift.yaml ]; then
  echo "hostshift: warning: this is not a linked worktree and declares no" >&2
  echo "  hostshift.yaml, so its own hostnames are the ones the database holds and" >&2
  echo "  there is nothing to map. Run this in a worktree, or declare the hostnames" >&2
  echo "  the database really holds in hostshift.yaml." >&2
fi

# And what the checkout this worktree came from answers to.
#
# Those hostnames are the ones the *database* holds. `db:pull` search-replaced
# to the parent's hostname, not to the worktree's, and a worktree that gives
# itself a DDEV project of its own is by definition served at a hostname the
# database has never heard of. Asking `hostshift map` for this directory's map
# would build it against that served-at hostname: nothing to rewrite, every link
# still pointing at the parent, and `check` reporting the map injective and
# anchored. So when this is a linked worktree of a *different* DDEV project, its
# hostnames are the canonical side.
parent=""
parent_hosts=""
unreadable_parent=""
linked=""
common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
gitdir="$(git rev-parse --path-format=absolute --git-dir 2>/dev/null || true)"

# A linked worktree has a .git *file* pointing into the parent's .git directory,
# where a normal checkout has a .git directory. That is the reliable signal:
# when the parent has been moved or deleted `git rev-parse --git-common-dir`
# *fails* rather than naming an unreadable path, so testing its output alone
# read as "not a worktree at all" and skipped the parent path in silence — the
# map then had the worktree's own hostname as canonical, and because
# parent_hosts was empty the narrowing subtracted nothing, so the worktree kept
# claiming the parent's blog hostnames permanently rather than until a restart.
# A submodule has a .git file too, and its "parent" would be the superproject's
# modules directory — not a checkout, and warning about it is a false alarm.
# Only a linked worktree's gitdir points inside a .git/worktrees/ directory.
grep -q '/worktrees/' .git 2>/dev/null && linked=1
[ -n "$common" ] && [ "$common" != "$gitdir" ] && [ -d "$common" ] && linked=1

if [ -n "$linked" ] && [ -z "$common" ]; then
  unreadable_parent="$(sed -n 's/^gitdir: //p' .git 2>/dev/null | sed 's|/\.git/worktrees/.*||')"
  unreadable_parent="${unreadable_parent:-the checkout this worktree came from}"
elif [ -n "$linked" ]; then
  dir="$(dirname "$common")"
  ph="$(hostshift hosts -C "$dir" 2>/dev/null || true)"
  case "$ph" in
    # Nothing readable there. Distinct from the case below, and the two must not
    # be confused: this one is a problem and that one is not.
    #
    # A .ddev/config.yaml that is *present* but not parseable is the common
    # shape, and mid-rebase it is the common cause: conflict markers make the
    # YAML invalid, and "no DDEV config could be read there" then reads as
    # "the parent has no DDEV project", which sends the reader looking in the
    # wrong place entirely. Say which file, and what is in it.
    "") unreadable_parent="$dir"
        if [ -f "$dir/.ddev/config.yaml" ]; then
          if grep -q '^<<<<<<< ' "$dir/.ddev/config.yaml" 2>/dev/null; then
            unreadable_parent="$dir (its .ddev/config.yaml has unresolved conflict markers)"
          else
            unreadable_parent="$dir (its .ddev/config.yaml could not be parsed)"
          fi
        fi ;;
    # A repo that pins `name:` in its tracked config.yaml gives every worktree
    # the *same* DDEV project — same containers, same hostnames. There is nothing
    # to derive from elsewhere and nothing to subtract.
    "$hosts") : ;;
    *) parent="$dir"; parent_hosts="$ph" ;;
  esac
fi

# ddev_name reads `name:` out of a DDEV config file, the way DDEV reads it.
#
# `sed -n 's/^name: *//p'` alone kept the quotes on `name: "acme"` and the
# comment on `name: acme # local`, and a wrong project name is silent in both
# places it is used: `docker inspect ddev-"acme"-web` finds nothing, which reads
# as "the rival is not running" and lets a real hostname collision through, and
# copy-db streams from a db container that does not exist. CRLF for the same
# reason — a config.yaml edited on Windows leaves \r on the value.
ddev_name() {
  [ -f "$1" ] || return 0
  v="$(sed -n 's/^name:[[:space:]]*//p' "$1" | sed -n 1p | tr -d '\r')"
  # A quote delimits the value, so a '#' inside one is not a comment. Stripping
  # comments first turned `name: "a#b"` into `"a`; stripping them after
  # unquoting turned it into `a`. Only the unquoted form has a comment to strip.
  case "$v" in
    '"'*) printf '%s\n' "$v" | sed 's/^"\([^"]*\)".*$/\1/' ;;
    "'"*) printf '%s\n' "$v" | sed "s/^'\([^']*\)'.*\$/\1/" ;;
    *)    printf '%s\n' "$v" | sed -e 's/[[:space:]]*#.*$//' -e 's/[[:space:]]*$//' ;;
  esac
}

# ddev_docroot prints the project's docroot, from the same merged config
# ddev_name reads. `ddev exec -s web` lands in /var/www/html, which is the
# project root and not where WordPress lives, so wp-cli answered "This does not
# seem to be a WordPress installation" and the `2>/dev/null … || true` swallowed
# it — the database gate was a silent no-op on every project without a
# root-level wp-cli.yml supplying `path:`. That includes stock DDEV WordPress
# with `docroot: web`, and the fixture test/bootstrap-ddev.sh builds.
ddev_docroot() {
  for f in "$1"/config.yaml "$1"/config.*.yaml; do
    [ -f "$f" ] || continue
    v="$(sed -n 's/^docroot:[[:space:]]*//p' "$f" | sed -n 1p | tr -d '\r' \
      | sed -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'\$/\1/" \
      -e 's/[[:space:]]*#.*$//' -e 's/[[:space:]]*$//')"
    # An `if`, not `[ -n "$v" ] && …`. With `pipefail` set, a false `&&` on the
    # loop's last iteration is the whole pipeline's status, so a project whose
    # final config file declares no docroot made this function *fail* — and
    # `set -e` then ended the script at the assignment, several blocks before
    # anything it was called for.
    if [ -n "$v" ]; then printf '%s\n' "$v"; fi
  done | sed -n '$p'
  return 0
}

if [ "$cmd" = "copy-db" ]; then
  [ -n "$parent" ] || {
    echo "hostshift: no parent checkout to copy from — this is not a linked worktree" >&2
    echo "  of a different DDEV project. Use \`ddev import-db\` or a fresh pull." >&2
    exit 2; }
  from="$(basename "$parent")"
  # Every config.*.yaml, in DDEV's merge order — config.yaml alone is the same
  # mistake the collision gate two blocks up was fixed for. A parent that names
  # itself in a config.*.local.yaml made this grep for the wrong ddev-<name>-db
  # and let a copy through that writes into an idle container while the
  # application goes on reading the parent's.
  for pc in "$parent/.ddev/config.yaml" $(LC_ALL=C printf '%s\n' "$parent"/.ddev/config.*.yaml | LC_ALL=C sort); do
    [ -f "$pc" ] || continue
    n="$(ddev_name "$pc")"
    [ -n "$n" ] && from="$n"
  done

  # Sharing the parent's database and copying it are different decisions, and
  # doing both is worse than pointless: the dump goes into this worktree's own
  # idle `db` container while the application goes on reading and writing the
  # parent's — and copy-db says "copied", exit 0. The developer who ran it
  # *specifically to stop writing to the parent* is told they succeeded, and
  # carries on activating plugins and uploading media into the checkout they
  # were protecting.
  #
  # Ask the container, not the files. This grepped four paths for the parent's
  # db hostname and missed `.ddev/.env.web`, which is DDEV's own documented
  # place for per-service environment — measured: DB_HOST=ddev-<parent>-db there,
  # the worktree live on the parent's database, and copy-db reported success.
  # `printenv` in the web container sees every mechanism that can set it,
  # including ones DDEV has not invented yet, and it is what `check` already does
  # for the same reason.
  #
  # The container first, and its answer is final either way — including "no".
  # Testing `[ -z "$shared" ]` could not tell "the container says it is not
  # shared" from "there is no container to ask", so a running project that had
  # been un-shared was still blocked by a file left lying around.
  #
  # The file scan is the fallback for when nothing is running, which is exactly
  # when someone reaches for copy-db. It reads assignments, not any line that
  # mentions the hostname: a commented-out `# DB_HOST=ddev-<parent>-db` blocked
  # the copy and printed its own `#` back, with no way past — --force does not
  # bypass this guard — so a stale note permanently refused a legitimate copy.
  #
  # The project's own .env is in the list because that is where Bedrock keeps
  # DB_HOST. `printenv` in the web container cannot see it (phpdotenv reads it
  # inside PHP), and the previous list stopped at .ddev/, so the one shape most
  # likely in this fleet was missed by both halves of the guard.
  shared=""
  asked=""
  dbenv="$(ddev exec -s web printenv DB_HOST DATABASE_URL DB_URL 2>/dev/null || true)"
  [ -n "$dbenv" ] && asked=1
  case "$dbenv" in
    *"ddev-$from-db"*) shared="$(printf '%s\n' "$dbenv" | grep -F "ddev-$from-db" || true)" ;;
  esac
  # ...but the container's environment cannot see a dotenv file the application
  # reads for itself, so that one is checked either way.
  if [ -z "$shared" ] && { [ -z "$asked" ] || [ -f .env ]; }; then
    # An assignment: optional `export`, the name, `=`, and the parent's db host
    # in the value. `# DB_HOST=...` does not match, and neither does prose.
    # -E and no -r: a fixed file list, so a directory recursion is not wanted,
    # and $from goes through sed first because a project name containing `.` or
    # `+` would otherwise widen the pattern.
    fromre="$(printf '%s' "$from" | sed 's/[][\.*^$(){}?+|]/\\&/g')"
    # A shell assignment, a dotenv line, a YAML mapping value or a compose list
    # item — all of them are NAME, a separator, then the value. What none of them
    # is, is a comment.
    # The optional quote is not decoration. Compose's own documentation writes
    # environment entries as `- "KEY=value"`, and requiring [A-Za-z_] straight
    # after the `- ` meant every quoted spelling walked past the guard: the dump
    # then goes into this worktree's idle db container while the application
    # keeps reading the parent's, and copy-db prints "copied" and exits 0.
    q='["'"'"']?'
    assignment="^[[:space:]]*-?[[:space:]]*$q(export[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*$q[[:space:]]*[:=][^#]*ddev-$fromre-db"
    if [ -n "$asked" ]; then
      # The container already answered for its own environment; .env is the one
      # thing it could not see.
      shared="$(grep -sEn "$assignment" .env 2>/dev/null || true)"
    else
      # DDEV's per-service form is .ddev/.env.<service>, and a service name has
      # no dot in it. Taking the glob whole made `.ddev/.env.web.disabled` — a
      # override renamed aside precisely to turn it off — refuse the copy, with
      # no way past.
      envfiles=""
      for f in .ddev/.env.*; do
        [ -f "$f" ] || continue
        case "${f#.ddev/.env.}" in *.*) continue ;; esac
        envfiles="$envfiles $f"
      done
      # shellcheck disable=SC2086
      shared="$(grep -sEn "$assignment" \
        .ddev/config.yaml .ddev/config.*.yaml .ddev/docker-compose.*.yaml \
        .ddev/.env $envfiles .env 2>/dev/null || true)"
    fi
  fi
  if [ -n "$shared" ]; then
    echo "hostshift: this worktree is configured to *use* $from's database:" >&2
    printf '%s\n' "$shared" | sed 's/^/    /' >&2
    echo "  Copying into it would write the dump to this worktree's own db" >&2
    echo "  container, which nothing reads, and report success. Remove that" >&2
    echo "  override and \`ddev restart\` first." >&2
    exit 2
  fi

  # It overwrites. Refuse to do that silently to a database that has something
  # in it — the caller may well have meant `ddev import-db`, or may be in the
  # wrong directory, and there is no undo.
  if [ -z "$force" ]; then
    tables="$(ddev exec -s web bash -c \
      "mysql -h db -udb -pdb -N -B -e \"select count(*) from information_schema.tables where table_schema='db'\"" \
      2>/dev/null | tail -1 | tr -dc '0-9' || true)"
    if [ -n "$tables" ] && [ "$tables" -gt 0 ] 2>/dev/null; then
      echo "hostshift: this worktree's database already has $tables table(s)." >&2
      echo "  Copying from $from replaces them, and there is no undo." >&2
      echo "  Pass --force if that is what you want." >&2
      exit 2
    fi
  fi

  echo "hostshift: copying the database from $from" >&2
  # --add-drop-database --databases, so this replaces rather than merges.
  # mysqldump|mysql on its own only drops the tables the dump contains, so a
  # worktree whose database came from an older pull kept everything the parent no
  # longer has — a removed blog's wp_N_* set, an uninstalled plugin's tables — and
  # was then not in the state the parent is in, which is the whole claim. The
  # refusal message promises a replace; this makes it true.
  ddev exec -s web bash -c "set -o pipefail; mysqldump --single-transaction --quick \
    --no-tablespaces --add-drop-database --databases db -h ddev-$from-db -udb -pdb \
    | mysql -h db -udb -pdb" || {
    # Not "the copy failed", full stop — that reads as "nothing happened", and
    # it is only true if the dump never started. --add-drop-database puts
    # `DROP DATABASE` at the top of the stream, so an interruption after that
    # point — the laptop sleeping, the parent stopped mid-copy — leaves this
    # database dropped and partially reloaded. Saying so is the difference
    # between re-running the command and debugging a site that is now missing
    # half its tables.
    echo "hostshift: the copy failed." >&2
    echo "  Is $from running? \`ddev start $from\`" >&2
    echo "  This worktree's database may be half-replaced: the dump drops it" >&2
    echo "  before reloading. Re-run with --force once $from is up." >&2
    exit 1; }
  echo "hostshift: copied. It still holds $from's hostnames, which is what" >&2
  echo "  hostshift maps — nothing else to do." >&2
  exit 0
fi

# hostshift.yaml, where a project has one, is a deliberate statement about which
# hostnames the database holds — usually because it names alias hostnames from
# other environments, or production ones the database was never search-replaced
# away from. Passing --from would override it.
map_args=()
# The parent declares canonical hostnames this worktree cannot see.
#
# `hostshift hosts -C <dir>` reads the parent's *DDEV* config and nothing else,
# so a parent that has adopted a committed hostshift.yaml — the README's
# production-canonical path — is invisible from a worktree whose branch predates
# that commit. The map then rewrote the parent's ddev.site hostnames, which is
# the wrong side entirely: the shared database holds the canonical names, so
# nothing is rewritten and every link on the preview points at the client's live
# site, while `check` reports the map injective and anchored.
#
# Adopting production-canonical is exactly the moment worktrees exist on older
# branches, so this is the common case rather than the odd one.
parent_declares=""
parent_declares_msg=""
db_confirms_map=""
parent_declares_warn() {
  echo "hostshift: warning: $parent_declares declares the hostnames its database" >&2
  echo "  holds, and this worktree's branch predates it — so the map below was" >&2
  echo "  built from that checkout's DDEV hostnames instead, and would rewrite" >&2
  echo "  nothing. Every link would point at the canonical site." >&2
  echo "  If the database holds those hostnames, merge the branch that adds" >&2
  echo "  hostshift.yaml. If it holds this checkout's DDEV hostnames — which is" >&2
  echo "  what \`copy-db\` and a search-replace leave behind — the map below is" >&2
  echo "  already right and there is nothing to do. Copying the file in when" >&2
  echo "  the database has not moved makes every page redirect to wp-signup." >&2
}
# Detection only. Whether it is *true* is decided further down, once there is a
# map to compare the parent's declaration against — see the block after
# `hostshift map --variant-hosts`.
if [ ! -f hostshift.yaml ] && [ -n "$parent" ] && [ -f "$parent/hostshift.yaml" ]; then
  parent_declares="$parent/hostshift.yaml"
  # Held, not printed, when `check` is the one asking.
  #
  # The database is consulted much further down, and it is what decides whether
  # this warning describes reality. Printing it up here meant a healthy worktree
  # — 200s, every link rewritten, the database still holding DDEV hostnames —
  # said "would rewrite nothing, every link would point at the canonical site"
  # on every start, and recommended the one action this file's own comments call
  # "the action that silently breaks the site" in that state.
  # Held in every mode, not just `check`: the comparison that decides whether
  # this is true has not run yet at this point in the file, and printing first
  # and comparing afterwards is how it came to be printed over healthy sites.
  parent_declares_msg=1
fi

if [ ! -f hostshift.yaml ] && [ -n "$unreadable_parent" ]; then
  # A linked worktree whose parent declares nothing readable. Falling through
  # silently is the failure this whole path exists to prevent: the map gets built
  # against the hostname the worktree is *served at*, every page loads, every
  # link stays wrong, and `check` calls it injective and anchored.
  echo "hostshift: warning: this is a worktree of $unreadable_parent, but no DDEV" >&2
  echo "  config could be read there, so the map falls back to this project's own" >&2
  echo "  hostnames. If the database came from that checkout it holds *its*" >&2
  echo "  hostnames, and nothing will be rewritten. Declare them in hostshift.yaml." >&2
fi
if [ ! -f hostshift.yaml ] && [ -n "$parent_hosts" ]; then
  # Said out loud, because "map from --from/--to" does not tell anyone which
  # checkout those origins came from, and that is the one thing worth knowing.
  # What this line can honestly claim is where the hostnames came from. It used
  # to add "whose database this shares", which `copy-db` exists to make false —
  # and it kept printing on every boot afterwards, a factual claim about the
  # developer's environment contradicted by the command's own closing line.
  # Asking the container would be discovery, and §4.1 says the map is declared.
  echo "hostshift: canonical hostnames from $parent, the checkout this was made from" >&2
  while IFS= read -r h; do
    [ -n "$h" ] && map_args+=(--from "https://$h")
  done <<<"$parent_hosts"
fi

# The map is the binary's business; parse only what this needs from it.
variants="$(hostshift map --slug "$slug" "${map_args[@]+"${map_args[@]}"}" --variant-hosts \
  | paste -sd, -)"

# Now that there *is* a map, ask whether the parent's declaration disagrees with
# it — which is the question the warning above claims to answer and never asked.
#
# The condition was pure file existence: the parent has a hostshift.yaml this
# branch does not. That fires in the ordinary case where the worktree's map
# already names exactly what the parent declares, and it printed "the map would
# rewrite nothing, every link would point at the canonical site" over a
# deployment serving 200s with every origin rewritten and `hostshift diff`
# GREEN — then exited 2, so `ddev start` failed and an unattended check saw a
# correct deployment fail, permanently, with no way to clear it.
#
# Comparing two *declarations* is not the discovery mechanism §4.1 forbids. The
# database gate was wrong four rounds running because it interrogated the
# application; this asks two config files what they say, which is what the map
# is built from in the first place.
if [ -n "$parent_declares" ]; then
  # The canonical *origins*, from --pairs, not --canonical-hosts.
  #
  # --canonical-hosts is documented as "aliases included", and an alias is one
  # of exactly two things the README says a hostshift.yaml exists for. So the
  # parent's set always carried hostnames the worktree's map does not name, the
  # sets were never equal, and the refusal still stood on the configuration the
  # comparison was written to clear — while the deployment served every page
  # with zero canonical origins remaining. The other shape, the one without
  # aliases, is the hostshift.yaml nobody would write.
  #
  # It also drops the port, so a parent declaring `https://h:8443` compared
  # equal to a map naming `https://h` and the warning was *cleared* — while the
  # engine, which matches on exact origin equality, correctly served content
  # holding `:8443` straight through. Wrong in both directions from one flag.
  #
  # --pairs emits `canonical=variant` per site, so the left-hand side is the
  # canonical origin with its scheme and port and without aliases. Whether the
  # map covers every alias the parent declares is a different question, and it
  # belongs to the database gate below: this one asks only whether the map is on
  # the right *side*, which is what the warning's own text claims.
  #
  # --slug because `map` refuses to resolve without a variant, even though the
  # slug cannot affect the canonical side, which is the only side compared.
  declared="$(hostshift map -C "$parent" --slug "$slug" --pairs 2>/dev/null \
    | sed 's/=.*$//' | sort -u || true)"
  mapped="$(hostshift map --slug "$slug" "${map_args[@]+"${map_args[@]}"}" \
    --pairs 2>/dev/null | sed 's/=.*$//' | sort -u || true)"
  # Every declared canonical must be in the map — subset, not overlap.
  #
  # Equality was wrong in both directions. The warning's own text is "the map
  # was built from that checkout's DDEV hostnames instead, and would rewrite
  # nothing" — and "would rewrite nothing" is true exactly when the two sets are
  # *disjoint*, which is the production-canonical case this exists for: the
  # parent declares https://www.client.fi and the map names acme.ddev.site.
  #
  # Anything short of disjoint means the map is on the right side. A parent
  # declaring one site with an alias, against a worktree mapping two sites
  # because DDEV lists the alias as an additional hostname, is the same
  # arrangement written two ways — and demanding equality refused it.
  #
  # Only when the parent actually declared something we could read. An empty
  # answer means the comparison failed, not that the two agree, and silence
  # there would reintroduce the leak this warning exists for.
  #
  # Overlap was too weak in the direction that leaks. A parent declaring a
  # production canonical *and* a DDEV hostname overlapped on the DDEV one, the
  # warning cleared, and the production origins were served to the browser
  # unrewritten — `check` exit 0, and `hostshift diff` GREEN too, because that
  # origin is not in its map either. This gate was the only thing that was ever
  # going to catch it.
  #
  # What matters is whether the map covers everything the parent declares, so
  # the leftover is `declared` minus `mapped`. Equality was wrong because the
  # map legitimately holds more (DDEV lists a declared alias as an additional
  # hostname); a non-empty leftover is the map holding *less*.
  unmapped="$(comm -23 <(printf '%s\n' "$declared") <(printf '%s\n' "$mapped") || true)"
  if [ -n "$declared" ] && [ -n "$mapped" ] && [ -z "$unmapped" ]; then
    parent_declares=""
    parent_declares_msg=""
  fi
fi

# `check` holds it until it has the container state and the probe; everything
# else says it here, now that the comparison has decided whether it is true.
if [ -n "$parent_declares" ] && [ "$cmd" != "check" ]; then
  parent_declares_warn
fi
[ -n "$variants" ] || { echo "hostshift produced no map — run 'hostshift check'" >&2; exit 2; }

# Nothing anywhere checks that two projects do not claim the same hostname —
# DDEV validates hostname syntax per project and no more, and traefik resolves a
# tie by rule length rather than complaining. Two branches whose slugs collide
# therefore give two worktrees identical VIRTUAL_HOST entries, and one of them
# silently serves the other's code at the URL its author is reviewing. The
# 30-character truncation makes that likelier, not rarer: PROJ-123-fix-cart and
# proj/123/fix-cart already collide, as does any pair sharing a 30-character
# prefix. Checking is cheap — every configured project leaves its variants in
# .ddev/.env — so check.
here="$(pwd -P)"

# Every project DDEV knows about, not just the directories next door.
#
# `../*/.ddev/.env` sees a sibling and nothing else, so two worktrees of one
# parent in different directories — `git worktree add ~/worktrees/foo`, or two
# developers with worktrees under their own home directories — collided in total
# silence: both `.ddev/.env` files carried the same HOSTSHIFT_VARIANTS, both
# projects were up, and `check` in each printed "hostshift is serving" and exited
# 0. Meanwhile a *dead* fake sibling — a bare directory with a .ddev/.env and no
# containers — warned immediately. This is the one check whose job is to stop a
# developer reviewing someone else's code at their own preview URL, and it was
# blind to the arrangement where that most easily happens.
#
# ~/.ddev/project_list.yaml holds every project's approot. Siblings stay in the
# list because a project that has never been started is not in the registry yet.
# `|| true` on the registry read, and newline-delimited iteration.
#
# `[ -f "$reg" ] && sed …` was the last command of the group, so a missing
# project_list.yaml made the group exit 1, pipefail made the pipeline exit 1, the
# assignment inherited it and `set -e` killed the script — no diagnostic, exit 1
# rather than the documented 2, on a DDEV install that has never registered a
# project. That is the same class the block below documents having already fixed
# once. And `for x in $list` splits on spaces, so an approot under
# `~/My Projects/` was invisible to the very check that exists for "two
# developers with worktrees under their own home directories".
scan_dirs="$(
  {
    for d in ../*/; do printf '%s\n' "${d%/}"; done
    reg="${DDEV_GLOBAL_CONFIG:-$HOME/.ddev}/project_list.yaml"
    if [ -f "$reg" ]; then
      sed -n 's/^[[:space:]]*approot:[[:space:]]*//p' "$reg"
    fi
  } 2>/dev/null | while IFS= read -r d; do
    # Resolved, then deduped. `../foo` from the glob and the absolute approot
    # from the registry are the same directory spelled two ways, and sorting the
    # raw strings deduped neither — so every sibling that was also registered
    # warned twice, with the same text, about the same project.
    [ -d "$d" ] || continue
    (cd "$d" 2>/dev/null && pwd -P) || true
  done | LC_ALL=C sort -u || true
)"

while IFS= read -r other_dir; do
  [ -n "$other_dir" ] || continue
  other="$other_dir/.ddev/.env"
  [ -f "$other" ] || continue
  odir="$(cd "$other_dir" 2>/dev/null && pwd -P)" || continue
  [ "$odir" = "$here" ] && continue
  # No `| head -1`: this script runs under `set -o pipefail`, and a head that
  # exits after one line SIGPIPEs whatever is still writing, failing the whole
  # pipeline. It is timing-dependent, so it passes on a fast small write and
  # fails on a slow one — sed that stops at the first match instead.
  # `|| true`, and stderr discarded: this is the one sed in the file reading a
  # *foreign* file, and a sibling project whose .ddev/.env the current user
  # cannot read — the file this codebase says holds credentials — made a failed
  # command substitution abort everything under `set -e`. That took out init,
  # check, env, loopback and wp-cli at once, including the check the post-start
  # hook runs on every start, with a bare `sed: Permission denied` and no
  # hostshift diagnostic. An unreadable sibling is not this project's problem.
  ovar="$(sed -n '/^HOSTSHIFT_VARIANTS=/{s///p;q;}' "$other" 2>/dev/null || true)"
  [ -n "$ovar" ] || continue
  for v in $(printf '%s' "$variants" | tr ',' ' '); do
    case ",$ovar," in *",$v,"*)
      echo "hostshift: warning: $odir already claims $v." >&2
      echo "  Two projects answering to one hostname is not an error anywhere in DDEV;" >&2
      echo "  the router picks one and the other is silently unreachable. Pass --slug to" >&2
      echo "  choose a different name." >&2
      # The warning is right either way; the *refusal* is not. A worktree that
      # was `ddev delete`d but whose directory stayed still has its .ddev/.env,
      # and `git worktree remove` refuses while untracked files are present, so
      # the directory staying is the common case rather than the odd one. That
      # made `check` exit 2 — failing the post-start hook on every single start —
      # over a claim nothing was making, while routing was perfectly correct, and
      # the advice to pass --slug was wrong for that case.
      #
      # So only a *live* claim is fatal. If the rival is not running there is
      # nothing to lose a routing tie to today.
      # Every config.*.yaml, in DDEV's own merge order, not config.yaml alone.
      # config.yaml is *tracked*, so in a sibling worktree it holds the parent
      # repo's pinned `name:` while the worktree's own name lives in a
      # config.*.local.yaml — which is the shape this repo's test harness uses
      # and the shape a worktree naturally takes. Reading config.yaml alone
      # therefore asked docker about the *parent*, which is running by
      # definition, so every stale sibling .ddev/.env was fatal again and the
      # liveness gate was inert. That is the same mistake this file already
      # fixed for the current project two blocks down.
      oname="$(basename "$odir")"
      for oc in "$odir/.ddev/config.yaml" "$odir"/.ddev/config.*.yaml; do
        [ -f "$oc" ] || continue
        n="$(ddev_name "$oc")"
        [ -n "$n" ] && oname="$n"
      done
      # The *hostshift* container, not web. The variant hostnames are served by
      # the sibling's proxy, so a sibling whose project is up while its proxy is
      # not claims nothing — and asking about web read every one of those as a
      # live claimant: an add-on removed but its `.ddev/.env` left behind (which
      # removal does by design, and says so), a proxy that crashed and stayed
      # down because the compose service is `restart: "no"`, or a `.ddev/.env`
      # written and never restarted into. `check` then failed on every start of
      # a deployment that was entirely correct, and told the developer to rename
      # a preview URL they may already have shared. This file handles exactly
      # that crashed-proxy case for the *current* project two blocks down.
      if [ "$(docker inspect "ddev-$oname-hostshift" --format '{{.State.Running}}' 2>/dev/null || true)" = "true" ]; then
        claimed="$v"
        break 2
      fi
      # Not `break 2`. A dead sibling is not a claim, and stopping at the first
      # one meant a *live* rival further down the list was never examined —
      # check then printed "hostshift is serving" and exited 0 while traefik
      # routed that hostname elsewhere, which is the exact failure this block
      # exists to catch.
      echo "  ($oname's proxy is not running, so nothing is serving it right now.)" >&2
      break ;;
    esac
  done
done <<<"$scan_dirs"

# The same question asked of Docker, which is the only place a renamed project
# still exists.
#
# Everything above enumerates *directories* — siblings, plus the approots the
# registry knows. `mv wt-a wt-a-renamed && ddev start` leaves the old project's
# containers up with the same VIRTUAL_HOST, and the scan cannot see it by
# construction: the rival's registered approot no longer exists so it is
# skipped, and its `.ddev/.env` travelled with the directory, so it reads as
# self. DDEV itself said "Router count mismatch: 122 loaded, 130 expected" and
# traefik had four routers on one hostname while `check` printed "hostshift is
# serving" and exited 0.
#
# A running container carries its own identity, so this needs no directory to
# exist. It is the last thing tried because it is the slowest, and it is skipped
# entirely when a directory-based claim was already found.
if [ -z "$claimed" ] && command -v docker >/dev/null 2>&1; then
  # DDEV_SITENAME, for the reason the block below already gives: DDEV merges
  # config.*.yaml and config.*.local.yaml is where a worktree names itself, so
  # re-deriving the name from config.yaml alone gets it wrong on exactly the
  # projects this command exists for. I made that mistake here on the first
  # attempt and the project reported *itself* as a rival, refusing every healthy
  # worktree — the same bug, in the same file, two hundred lines apart.
  self_name="${DDEV_SITENAME:-}"
  if [ -z "$self_name" ]; then
    self_name="$(ddev_name .ddev/config.yaml)"
    for oc in .ddev/config.*.yaml; do
      [ -f "$oc" ] || continue
      n="$(ddev_name "$oc")"
      if [ -n "$n" ]; then self_name="$n"; fi
    done
  fi
  if [ -z "$self_name" ]; then self_name="$(basename "$(pwd -P)")"; fi
  self="ddev-$self_name-hostshift"
  running="$(docker ps --filter 'name=-hostshift' --format '{{.Names}}' 2>/dev/null || true)"
  while IFS= read -r c; do
    [ -n "$c" ] || continue
    if [ "$c" = "$self" ]; then continue; fi
    # And by approot, which identifies a project whatever it is called.
    #
    # Editing `name:` and running check before restarting made the running
    # container's name stop matching $DDEV_SITENAME, so the project reported its
    # own live proxy as a rival whose directory no longer exists — and the
    # remedy it printed would stop the very proxy serving the page. DDEV refuses
    # to complete such a rename, so the state is transient, but the advice was
    # wrong while it lasted.
    oa="$(docker inspect "$c" --format '{{index .Config.Labels "com.ddev.approot"}}' \
      2>/dev/null || true)"
    if [ -n "$oa" ] && [ "$oa" = "$here" ]; then continue; fi
    ov="$(docker inspect "$c" --format \
      '{{range .Config.Env}}{{println .}}{{end}}' 2>/dev/null \
      | sed -n 's/^VIRTUAL_HOST=//p' | head -1 || true)"
    [ -n "$ov" ] || continue
    while IFS= read -r v; do
      [ -n "$v" ] || continue
      case ",$ov," in
        *",$v,"*)
          claimed="$v"
          echo "  (claimed by the running container $c, whose project directory" >&2
          echo "  no longer exists under that name — a rename leaves the old" >&2
          echo "  containers up. \`docker stop $c\` or \`ddev stop\` it.)" >&2
          break 2 ;;
      esac
    done <<<"$(printf '%s' "$variants" | tr ',' '\n')"
  done <<<"$running"
fi


# web keeps this project's own hostnames, minus the variants and minus the
# parent's. DDEV puts every additional hostname on web's VIRTUAL_HOST, so
# without narrowing it web and hostshift both claim the variants and the router
# picks web — WordPress then sees a variant host, fails to match
# wp_blogs.domain, and redirects to wp-signup.php.
# This project's own primary hostname is never subtracted.
#
# A parent that lists the worktree's hostname in its own additional_hostnames —
# which teams do commit, for the mkcert SANs or as a leftover — made the
# subtraction remove *everything*, so HOSTSHIFT_WEB_HOSTS came out empty. The
# compose file read it as `${HOSTSHIFT_WEB_HOSTS:-$DDEV_HOSTNAME}`, and `:-`
# treats empty as unset, so web fell back to every hostname the worktree
# registers — the exact inverse of narrowing, permanently, in the configuration
# where the subtraction has the most to do. Both `init` and `check` reported
# success, because check compares .ddev/.env against a recomputation of itself
# and both said the same empty thing.
#
# A project must be reachable at its own name regardless of what the parent
# claims, so that one is kept before the subtraction runs.
own="$(printf '%s' "$hosts" | sed -n 1p)"
web=""
while IFS= read -r h; do
  [ -n "$h" ] || continue
  case ",$variants," in *",$h,"*) continue ;; esac
  if [ "$h" != "$own" ]; then
    case "
$parent_hosts
" in *"
$h
"*) continue ;; esac
  fi
  web="${web:+$web,}$h"
done <<<"$hosts"

# The map the proxy cannot work out for itself.
#
# The compose service mounts ${DDEV_APPROOT}:/project — this worktree, and only
# this worktree. The checkout it branched from is not in the container and never
# will be, so the canonical hostnames, which live over there, are unknowable
# inside it. `proxy -C /project` on a repo with no hostshift.yaml therefore built
# its map from the worktree's own DDEV config, where a missing `name:` defaults
# to the *directory basename* — which inside the container is literally
# "project". The proxy came up mapping https://project.ddev.site, the router sent
# it wt-a--transformerco.ddev.site, and every request 421'd.
#
# So it is resolved here, on the host, where the parent checkout is readable, and
# handed over. Only when there is no hostshift.yaml: that file *is* mounted, it
# carries aliases a canonical=variant list cannot express, and the container
# reads it correctly.
hsmap=""
if [ ! -f hostshift.yaml ]; then
  # Repeated --from/--to, not `--map c=v,c=v`. Comma-separated --map is a flag
  # form this branch added, and the image is :latest: the published binary splits
  # the whole string on its first `=`, so a two-site map came out as one site
  # whose variant host was "wt-a--acme.ddev.site,https" and every variant 421'd —
  # while `ddev start`, `ddev hostshift check` and `hostshift map` on the host all
  # reported success. --from/--to is index-aligned and repeatable and always was,
  # so it works against the image already published as well as a current one.
  #
  # The whole flag sequence, not just its value: docker-compose's string command
  # form drops an argument that expands to nothing, so empty means no map flags
  # at all — which is right when a hostshift.yaml is mounted.
  hsmap=""
  while IFS='=' read -r c v; do
    [ -n "$c" ] || continue
    hsmap="${hsmap:+$hsmap }--from $c --to $v"
  done <<<"$(hostshift map --slug "$slug" "${map_args[@]+"${map_args[@]}"}" --pairs)"
  [ -n "$hsmap" ] || { echo "could not resolve a map to hand the proxy" >&2; exit 2; }
fi

# DDEV derives `name` from the directory but not additional_hostnames, so a
# worktree inherits the parent's extra hostnames verbatim and registers them as
# its own. traefik has no cross-project uniqueness check — DDEV's own
# ValidateConfig only checks hostname *syntax* — and it resolves the tie by rule
# length. A worktree's directory name is the parent's plus a suffix, so its rule
# is always the longer one: the worktree wins every shared hostname, every time,
# and `ddev start` says nothing.
#
# HOSTSHIFT_WEB_HOSTS below hands them back at the next restart. The window
# between the worktree's first `ddev start` and that restart is real, though, and
# during it the *parent's* blog is served by the worktree. This is the one moment
# anyone can act on it. Upstream: ddev/ddev#5486, reopened for git worktrees.
# Not on `check`. The note is a static intersection of the two projects'
# declared hostnames, so it was true when init said it and false ever after —
# and the post-start hook printed it on every start, including the restart that
# had just handed those hostnames back to the parent. Four lines of "until
# `ddev restart`, those serve this worktree" from the hook of that very restart.
# The parent claiming *this* project's own hostname is a collision too, and
# nothing looked for it.
#
# Keeping the own hostname out of the subtraction stops HOSTSHIFT_WEB_HOSTS
# emptying, but it does not make the project reachable there: both projects then
# put that name on web's VIRTUAL_HOST, the rules are the same length, and traefik
# breaks the tie by an ordering neither project controls. Measured, the parent
# won — so `ddev launch`, `ddev describe` and every `ddev restart` line in the
# worktree named a URL serving someone else's code and database. The collision
# scan only ever looked at siblings' *variants*.
if [ -n "$parent_hosts" ] && [ -n "$own" ]; then
  case "
$parent_hosts
" in *"
$own
"*)
    echo "hostshift: warning: the parent checkout also registers $own," >&2
    echo "  which is this project's own hostname. Both put it on web, the router" >&2
    echo "  breaks the tie by an order neither controls, and \`ddev describe\` here" >&2
    echo "  will name a URL that may serve the parent. Drop it from the parent's" >&2
    echo "  additional_hostnames, or rename this worktree." >&2
    ;;
  esac
fi

# `init` only, not every subcommand that is not check.
#
# The note says those hostnames serve this worktree "until `ddev restart`",
# which is true when init says it and false ever after — so `env`, `wp-cli` and
# `loopback` printed it on an already-restarted, entirely healthy worktree,
# telling the developer their worktree was stealing a hostname it was not and
# pointing them at remedial action they should not take.
if [ -n "$parent_hosts" ] && [ "$cmd" = "init" ]; then
  shared=""
  while IFS= read -r h; do
    [ -n "$h" ] || continue
    case "
$parent_hosts
" in *"
$h
"*) shared="${shared:+$shared, }$h" ;; esac
  done <<<"$hosts"
  if [ -n "$shared" ]; then
    echo "hostshift: note: this worktree also registered $shared," >&2
    echo "  inherited verbatim from the tracked .ddev/config.yaml — DDEV derives the" >&2
    echo "  project name from the directory but not the additional hostnames. Until" >&2
    echo "  \`ddev restart\`, those serve this worktree rather than $(basename "$parent")." >&2
  fi
fi

# One variable, not two. `--slug` and the map args are mutually exclusive by
# construction: internal/config returns early on --from/--to, so the slug is
# never read once a map is given — and when a mounted hostshift.yaml supplies the
# canonical side, the slug is the only way to derive the variant. Shipping both
# meant one of them was always dead, and the multisite example showed an empty
# HOSTSHIFT_MAP_ARGS= line that reads like a bug.
args="${hsmap:---slug $slug}"

# #ddev-silent-no-warn, because DDEV otherwise prints a four-line "Custom
# configuration detected" block naming this file on every single start. It is a
# legal dotenv comment and DDEV documents the marker in that very message.
# HOSTSHIFT_SLUG is written only when the slug was *chosen* rather than derived
# from the branch, and it is what makes --slug stick.
#
# `check` re-derives the slug from the current branch, which is right for a slug
# that came from a branch and wrong for one the developer picked: `init --slug
# review-42` on branch `main` deployed correctly, served correctly, and then
# failed the post-start hook on every single start, because check compared the
# deployed `--slug review-42` against a freshly derived `--slug main`. Worse, the
# advice it printed — `ddev hostshift init` — silently reverts to the branch
# slug when run as printed, which in the case that motivates --slug at all is
# back onto the colliding name the collision warning told you to move off.
env_out="#ddev-silent-no-warn${slug_explicit:+
HOSTSHIFT_SLUG_CHOSEN=$slug}
HOSTSHIFT_ARGS=$args
HOSTSHIFT_VARIANTS=$variants
HOSTSHIFT_WEB_HOSTS=$web"


# `hostshift check` on its own is the wrong question in a worktree, and answers
# it confidently: run without --from it resolves layer 1 against *this* checkout,
# reports the map injective and anchored, and exits 0 — for a map whose canonical
# hostname appears nowhere in the database and which the proxy never sees. It is
# also what the README, this add-on's own post-install text and the proxy's 421
# body all tell you to run.
#
# So the DDEV-shaped question is asked here, where knowing what a worktree is is
# allowed: check the map that would be deployed, and whether what *is* deployed
# still matches it.
# A worktree that needs to *write* — activate a plugin, run a migration, upload
# media — needs a database of its own rather than the parent's. The fastest
# source is the parent itself: every DDEV container is on ddev_default, so the
# worktree's web container can reach the parent's db container by name and stream
# one into the other. No dump on disk, no compression, no production round trip,
# and it is the state you are already working against.
#
# It does not touch hostnames. Whatever is copied still holds the parent's, which
# is exactly why hostshift is needed afterwards just as much as before.
if [ "$cmd" = "check" ]; then
  hostshift check --slug "$slug" "${map_args[@]+"${map_args[@]}"}" || exit $?

  if [ ! -f .ddev/.env ]; then
    echo "hostshift: nothing deployed yet — run \`ddev hostshift init\`" >&2
    exit 2
  fi

  # Is the file current? The whole block, not one variable of it: a renamed
  # worktree drifts only in HOSTSHIFT_WEB_HOSTS, a parent that gains a blog only
  # in HOSTSHIFT_VARIANTS, and a hostshift.yaml appearing only in HOSTSHIFT_ARGS
  # — where the deployed flat map goes on beating the file, so its aliases
  # silently never rewrite.
  # The same four keys `init` writes and strips, not `^HOSTSHIFT_`. The two
  # disagreed: init left a v0.1.0 project's leftover HOSTSHIFT_SLUG= and
  # HOSTSHIFT_MAP_ARGS= lines alone while check counted them, so check reported
  # "out of date" forever on exactly the upgraded projects. It also swept up any
  # variable of the developer's own sharing the prefix — and the compose file
  # reads HOSTSHIFT_* names, so that is how someone arrives at one.
  deployed="$(grep -e '^HOSTSHIFT_ARGS=' -e '^HOSTSHIFT_VARIANTS=' -e '^HOSTSHIFT_WEB_HOSTS=' \
    -e '^HOSTSHIFT_SLUG_CHOSEN=' -e '^#ddev-silent-no-warn' .ddev/.env | tr -d '\r' || true)"
  if [ "$deployed" != "$env_out" ]; then
    echo "hostshift: .ddev/.env is out of date. It says" >&2
    printf '%s\n' "${deployed:-  nothing}" >&2
    echo "  and this project now resolves to" >&2
    printf '%s\n' "$env_out" >&2
    if [ -n "$unreadable_parent" ]; then
      echo "  Not \`ddev hostshift init\` — the map above was built from this" >&2
      echo "  worktree's own hostnames because $unreadable_parent could not be" >&2
      echo "  read, and deploying it would rewrite nothing and take the parent's" >&2
      echo "  hostnames with it. Fix that checkout first." >&2
    else
      echo "  Run \`ddev hostshift init\`, which restarts to pick it up." >&2
    fi
    exit 2
  fi

  # And is the file what is *running*? Everything above compares the file to a
  # recomputation of the file, which cannot see the commonest failure there is:
  # `init` without the `ddev restart` it just told you to run. It reported
  # success with every container stopped, and after a slug change while the old
  # slug was still being served. So ask the container.
  # DDEV_SITENAME is what DDEV itself calls this project, and it hands it to
  # host commands. Re-deriving it here read .ddev/config.yaml only, while DDEV
  # merges config.*.yaml — and config.*.local.yaml is the natural place for a
  # worktree to name itself, so a correctly configured worktree was told its
  # proxy was not running, on every single `ddev start`.
  name="${DDEV_SITENAME:-$(basename "$(pwd -P)")}"
  # .State.Running as well as the env: docker keeps Config.Env for a container
  # that has exited, and the compose service is `restart: "no"`, so a proxy that
  # crashed stays down — and reporting its *configured* hostnames as served
  # certified a total outage as healthy while every variant 502'd.
  state="$(docker inspect "ddev-$name-hostshift" \
    --format '{{.State.Running}}{{"\n"}}{{range .Config.Cmd}}{{.}} {{end}}{{"\n"}}{{range .Config.Env}}{{println .}}{{end}}' \
    2>/dev/null || true)"
  alive="$(printf '%s' "$state" | sed -n '1p')"
  cmd_running="$(printf '%s' "$state" | sed -n '2p')"
  running="$(printf '%s' "$state" | sed -n '/^VIRTUAL_HOST=/{s///p;q;}')"
  if [ -z "$alive" ]; then
    echo "hostshift: no ddev-$name-hostshift container. \`ddev restart\` to serve" >&2
    echo "  $variants" >&2
    exit 2
  fi
  if [ "$alive" != "true" ]; then
    echo "hostshift: the proxy container has exited, so every variant 502s." >&2
    echo "  \`ddev logs -s hostshift\` for why, then \`ddev restart\`." >&2
    exit 2
  fi
  if [ -z "$running" ]; then
    echo "hostshift: the proxy is running but answers on nothing —" >&2
    echo "  its VIRTUAL_HOST is empty. \`ddev hostshift init && ddev restart\`." >&2
    exit 2
  fi
  if [ "$running" != "$variants" ]; then
    echo "hostshift: the running proxy answers on" >&2
    echo "  $running" >&2
    echo "  but .ddev/.env now says" >&2
    echo "  $variants" >&2
    echo "  Run \`ddev restart\`." >&2
    exit 2
  fi

  # VIRTUAL_HOST says which hostnames reach the proxy. It says nothing about the
  # map the proxy was started with — and a proxy that is running, routed, and
  # 421ing every hostname it is routed for was reported as healthy. That is the
  # failure this file has warned about twice (`--map ""`, then a comma-separated
  # `--map`), and it is what an upgrade produces when the two halves of the
  # add-on disagree about a variable name.
  case " $cmd_running " in
    *" $args "*) ;;
    *) echo "hostshift: the proxy is running with a different map than .ddev/.env" >&2
       echo "  says. It was started with:" >&2
       echo "    $cmd_running" >&2
       echo "  and .ddev/.env now asks for:" >&2
       echo "    $args" >&2
       echo "  Run \`ddev restart\`." >&2
       exit 2 ;;
  esac

  # Is every variant a name this machine will actually answer to?
  #
  # A production-canonical `hostshift.yaml` with no `base:` derives the variant
  # from the *canonical*, so `canonical: https://www.example.com` becomes
  # `local--www.example.com` — no DDEV TLD, no mkcert SAN, no DNS. Nothing
  # rejected it and `check` printed "hostshift is serving" for a hostname that
  # cannot resolve. Worse on a client domain with wildcard DNS, which is not
  # rare: the name resolves to the *production server*, so the developer
  # "reviewing their worktree" is looking at the live site, and loopback
  # containment does not help — it pins the canonical names, not this one.
  #
  # Ask the host file, not the shape of the name.
  #
  # A suffix test passes the very case it was written to stop. `hostshift hosts`
  # includes additional_fqdns verbatim, so a project that points the production
  # hostname at the box while adopting production-canonical — a natural move —
  # contributes the suffix `.example.com`, and `local--www.example.com` then
  # matches it. DDEV registers only the *exact* FQDN in /etc/hosts, so that name
  # has no local entry at all and resolves through public DNS: under the wildcard
  # records these domains often carry, straight to the production server, with
  # the developer believing they are reviewing a worktree.
  #
  # $DDEV_TLD is the question, because it is what decides *how* a name resolves.
  # DDEV sets it for every host command (ddev pkg/ddevapp/ddevapp.go).
  #
  # Names under the project TLD resolve by wildcard DNS — `*.ddev.site` is a real
  # public record pointing at the loopback — so any name under it works without
  # anything being registered anywhere, which is why variants normally need no
  # setup at all. Names *outside* it resolve only if DDEV wrote them to
  # /etc/hosts, and DDEV writes the exact FQDNs from additional_fqdns and nothing
  # derived from them.
  #
  # That distinction is the whole bug in the previous suffix test: a project that
  # points its production hostname at the box with additional_fqdns while
  # adopting production-canonical contributed the suffix `.example.com`, so
  # `local--www.example.com` matched and was accepted — a name with no local
  # entry, which resolves through public DNS to the production server under the
  # wildcard records these domains often carry.
  tld="${DDEV_TLD:-ddev.site}"
  outside=""
  for v in $(printf '%s' "$variants" | tr ',' ' '); do
    ok=""
    case "$v" in *".$tld") ok=1 ;; esac
    if [ -z "$ok" ]; then
      while IFS= read -r h; do
        [ "$h" = "$v" ] && { ok=1; break; }
      done <<<"$hosts"
    fi
    if [ -z "$ok" ] && grep -qE "^[^#]*[[:space:]]$v([[:space:]]|$)" /etc/hosts 2>/dev/null; then
      ok=1
    fi
    [ -n "$ok" ] || outside="${outside:+$outside }$v"
  done
  if [ -n "$outside" ]; then
    echo "hostshift: these variant hostnames are not under any domain this DDEV" >&2
    echo "  project registers, so nothing local answers to them:" >&2
    printf '    %s\n' $outside >&2
    echo "  On a client domain with wildcard DNS they resolve to *production*." >&2
    echo "  Declare \`base:\` on the site, pointing at this project's own" >&2
    echo "  hostname, so the variant is derived from a name DDEV serves." >&2
    exit 2
  fi

  # web's VIRTUAL_HOST, not only the proxy's.
  #
  # `check` inspected the hostshift container four different ways and never once
  # looked at web — so when the narrowing failed and web came up serving every
  # hostname the worktree registers, including the parent's blog, check could not
  # see it by construction: it compares .ddev/.env against a recomputation of
  # .ddev/.env, and both said the same wrong thing.
  #
  # Only when the file asks for something. An empty HOSTSHIFT_WEB_HOSTS is a real
  # answer but an unconfigured project has no answer at all, and a container that
  # is not running tells us nothing either.
  webenv="$(docker inspect "ddev-$name-web" \
    --format '{{range .Config.Env}}{{println .}}{{end}}' 2>/dev/null || true)"
  webrunning="$(printf '%s' "$webenv" | sed -n '/^VIRTUAL_HOST=/{s///p;q;}')"
  if [ -n "$webenv" ] && [ "$webrunning" != "$web" ]; then
    echo "hostshift: web is serving a different set of hostnames than .ddev/.env" >&2
    echo "  asks for. It has:" >&2
    echo "    ${webrunning:-(nothing)}" >&2
    echo "  and this checkout resolves to:" >&2
    echo "    ${web:-(nothing)}" >&2
    echo "  Anything there that also belongs to the parent is served by this" >&2
    echo "  worktree instead, and the router decides which. Run \`ddev restart\`." >&2
    exit 2
  fi

  # The parent-declares verdict is deferred to after the database gate, which is
  # the only thing here that can actually answer the question it asks. Refusing
  # at this point exited before that gate ever ran — so the check asserted "the
  # map does not name the hostnames the database holds" without ever having
  # looked at the database, on a deployment where the row said otherwise.

  if [ -n "$claimed" ]; then
    echo "hostshift: refusing to call this healthy — $claimed is claimed by" >&2
    echo "  another project too, and the router serves whichever it prefers." >&2
    exit 2
  fi

  # The map itself, not just the command line that asked for it.
  #
  # When the container resolves its own map from a mounted hostshift.yaml, the
  # command line is `--slug X` and stays `--slug X` however the file changes — so
  # editing hostshift.yaml and not restarting left `check` printing "hostshift is
  # serving" while the new alias rewrote nothing. Two attempts at closing this
  # were worse than the gap (a checksum at init time called a correctly restarted
  # project stale; a file mtime against the container's was unreliable across
  # platforms), and both were guessing at something the proxy states outright:
  # it prints its resolved map to stderr at startup, and `docker logs` still has
  # it. Comparing that against `hostshift map` here is exact, needs no recorded
  # state, and both sides render through the same Map.String().
  #
  # Best-effort by design. A rotated or truncated log yields no map block and is
  # not evidence of drift, so it says nothing rather than crying wolf.
  #
  # The block is delimited, not pattern-matched out of the whole log, and only
  # the *last* block counts. Both matter:
  #
  #   * Every straggler WARN carries a `context=` attribute whose value is raw
  #     page bytes. A page that merely mentions `https://old -> https://new`
  #     within 64 bytes of a straggler injected a phantom pair, `check` exited 2
  #     on every start, and the advice — `ddev restart` — could not help, because
  #     the line stays in the log until the container is *recreated*.
  #   * `docker logs` keeps output across a restart, and a hostshift.yaml edit
  #     changes the map without changing the compose definition, so the container
  #     is reused. Unioning the blocks compared the old map against the new one
  #     and never agreed again. Reading the last block compares what is actually
  #     running.
  #
  # `map from` opens the block and the version banner closes it; both are printed
  # by the same function, adjacent, before the first request is served.
  extract_map='
    /^hostshift: map from /   { inblock = 1; delete m; n = 0; next }
    inblock && /: listening on / { inblock = 0; next }
    inblock                   { m[++n] = $0 }
    END { for (i = 1; i <= n; i++) print m[i] }'
  # Same normalisation both sides: drop the site-name column and collapse the
  # alignment padding, which depends on the longest hostname in the map. No line
  # to skip on the host side — `hostshift map` prints its `map from` header to
  # stderr, so stdout is pair lines only, and dropping one ate a real pair.
  norm_map() { awk '{ sub(/^[^ \t]+[ \t]+/, ""); gsub(/[ \t]+/, " "); print }' | LC_ALL=C sort -u; }
  logs="$(docker logs "ddev-$name-hostshift" 2>&1 || true)"
  running_map="$(printf '%s\n' "$logs" | awk "$extract_map" | norm_map || true)"

  # The image's version against this command's.
  #
  # `ddev add-on get` installs the command and the compose file from the repo,
  # but the *engine* comes from a published image — so a developer can run
  # today's command in front of last week's proxy, and every behaviour added in
  # between is silently absent. Measured: on the published v0.1.0 image a feed
  # came back with eighteen canonical URLs unrewritten and `check` still said
  # "hostshift is serving", because it compares the map the container logged and
  # never its version. The proxy prints its version on the line every
  # `ddev logs -s hostshift` starts with, precisely so this is answerable.
  #
  # A warning, not a refusal: a lagging image is a reason to pull, not a reason
  # to fail every start. Nothing is said when either version is unknown.
  # A banner with no version is evidence, not the absence of it.
  #
  # v0.1.0 prints `hostshift: listening on …` — the version was added to that
  # line *after* it — so requiring a space after the name made running_ver empty
  # on the only skew that actually exists today, and the warning was silent on
  # exactly the case its comment cites as measured. A bannerless proxy is older
  # than the change that added the banner.
  running_ver="$(printf '%s\n' "$logs" | sed -n 's/^hostshift \([^:]*\): listening on.*/\1/p' | tail -1)"
  # `case` for the same reason as the probe body above: `docker logs` output
  # passes 64 KiB once straggler WARNs accumulate, and the pipeline would then
  # return 141 and silence the version-skew warning on the one image skew that
  # actually exists.
  logs_has_banner=""
  case "$logs" in
    "hostshift: listening on"*|*"
hostshift: listening on"*) logs_has_banner=1 ;;
  esac
  if [ -z "$running_ver" ] && [ -n "$logs_has_banner" ]; then
    running_ver="(older than v0.2.0)"
  fi
  host_ver="$(hostshift --version 2>/dev/null | tail -1 | tr -d '\r' || true)"
  if [ -n "$running_ver" ] && [ -n "$host_ver" ] && [ "$running_ver" != "$host_ver" ] &&
     [ "$running_ver" != "dev" ] && [ "$host_ver" != "dev" ]; then
    echo "hostshift: warning: the proxy image is $running_ver and this command is" >&2
    echo "  $host_ver. The add-on installs the command from the repository and the" >&2
    echo "  engine from a published image, so anything added between those two" >&2
    echo "  versions is not running here — silently, since the map and the" >&2
    echo "  hostnames still check out." >&2
    echo "  Pull it: \`docker pull ghcr.io/generoi/hostshift:latest && ddev restart\`." >&2
  fi
  if [ -n "$running_map" ]; then
    want_map="$(hostshift map --slug "$slug" "${map_args[@]+"${map_args[@]}"}" 2>/dev/null \
      | norm_map || true)"
    if [ -n "$want_map" ] && [ "$running_map" != "$want_map" ]; then
      echo "hostshift: the proxy is running a different map than this checkout" >&2
      echo "  now resolves to. It started with:" >&2
      printf '%s\n' "$running_map" | sed 's/^/    /' >&2
      echo "  and hostshift.yaml/DDEV config now give:" >&2
      printf '%s\n' "$want_map" | sed 's/^/    /' >&2
      echo "  Run \`ddev restart\`." >&2
      exit 2
    fi
  fi

  # One request, because everything above this line is inference.
  #
  # `check` inspects the container five ways — it exists, it is running, its
  # VIRTUAL_HOST, its command line, the map it logged — and web's VIRTUAL_HOST
  # besides, and then reports what is *configured* as though it were what is
  # served. Two states measured green with the URL returning 502: a directory
  # rename that left DDEV's old traefik routers behind pointing at a dead
  # container, and two live projects claiming one hostname. A single request
  # closes both.
  #
  # Only a hard routing failure is fatal. A 404, a 302 to wp-signup, a 401 — all
  # mean the request reached an application, which is what this is asking. curl
  # is not guaranteed present, so its absence is not an error either.
  if command -v curl >/dev/null; then
    probe="$(printf '%s' "$variants" | cut -d, -f1)"
    # Retried, because this runs in the post-start hook — the instant after
    # `ddev start` returns, when traefik may not have picked up the new router
    # yet. A single request would turn that ordinary race into a refusal on a
    # perfectly good project, and a check that cries wolf on every cold start is
    # worse than the gap it closes.
    # The router's port, and no proxy. DDEV supports a non-443 router port — the
    # standard remedy when something else owns 443 — and exports it to host
    # commands; without it the probe asked the wrong port and got nothing. An
    # https_proxy in the shell had the same effect.
    port=""
    case "${DDEV_ROUTER_HTTPS_PORT:-443}" in 443|"") ;; *) port=":$DDEV_ROUTER_HTTPS_PORT" ;; esac
    code=""
    rc=0
    for attempt in 1 2 3; do
      # Reset per attempt. Set once outside the loop, a first-attempt timeout —
      # the cold-start race the retries exist for — left rc=28 sticky, so two
      # subsequent 502s were relabelled "slow" and the refusal never ran. That is
      # exactly the failure this probe exists to catch, certified healthy on an
      # ordering that is ordinary on a busy machine.
      rc=0
      # The body as well as the code, so the one check that actually fetches a
      # page can say something about what came back. See probe_body below.
      probe_body="$(curl -sk --noproxy '*' -w '\n%{http_code}' \
        --connect-timeout 3 --max-time 10 "https://$probe$port/" 2>/dev/null)" || rc=$?
      code="$(printf '%s' "$probe_body" | sed -n '$p')"
      case "$code" in
        000|502) [ "$attempt" = 3 ] || sleep 2 ;;
        *) break ;;
      esac
    done
    # 28 is curl's timeout. A slow homepage — a cold opcache on a bind mount,
    # xdebug on, a heavy plugin set — is a site that answers, not a routing
    # failure, and refusing there cost 35 seconds on every boot and then blamed
    # the router. 503 and 504 are dropped for the same reason: maintenance-mode
    # plugins and WordPress core itself send 503 while `.maintenance` exists, and
    # an application that answers has answered.
    if [ "$rc" = 28 ]; then
      code="slow"
    fi
    case "$code" in
      000|502)
        echo "hostshift: everything is configured correctly, but https://$probe/" >&2
        echo "  answers ${code:-nothing} — so something between the router and the" >&2
        echo "  proxy is broken, not the configuration." >&2
        echo "  A stale router from a renamed project does this, and so does" >&2
        echo "  another project claiming the same hostname." >&2
        # Name the file, because none of the three remedies previously printed
        # clears it. DDEV keeps per-project router config in
        # .ddev/traefik/config/<name>.yaml *inside the project*, so renaming a
        # directory leaves the old name's file there permanently: two routers
        # register the same rule and traefik picks the one pointing at a
        # container that no longer exists. Measured, `ddev restart`,
        # `ddev stop && ddev start` and `ddev poweroff` all leave it — the file
        # is on disk and comes back on the next start. Deleting it fixes it
        # immediately, and the previous advice claimed the opposite in the very
        # case it named.
        stale=""
        for f in .ddev/traefik/config/*.yaml; do
          [ -f "$f" ] || continue
          case "$(basename "$f" .yaml)" in "$name") ;; *) stale="${stale:+$stale }$f" ;; esac
        done
        if [ -n "$stale" ]; then
          echo "  This project carries router config for a name it no longer has:" >&2
          printf '    %s\n' $stale >&2
          echo "  That is what a renamed directory leaves behind, and no restart" >&2
          echo "  clears it. Delete those files and \`ddev restart\`." >&2
        else
          echo "  Try \`ddev restart\`, then \`ddev stop && ddev start\`, and only" >&2
          echo "  then \`ddev poweroff\`, which retires every project's routers." >&2
        fi
        exit 2 ;;
    esac
  fi

  # A warning, never a refusal, and it clears nothing.
  #
  # This has been wrong in three consecutive audit rounds — it read the wrong
  # database, then read a value WordPress filters through WP_HOME, then read a
  # blank line and stopped running at all — and each fix was correct about the
  # previous failure and introduced the next. PLAN §4.1 says why the ground keeps
  # moving: "the application self-reports and cannot be interrogated … the map
  # must be declared, never discovered". Every version of this has been a
  # discovery mechanism wearing a different hat.
  #
  # So it keeps the signal and gives up the authority. It cannot fail a start,
  # and it can no longer clear the parent-declares warning — the two things that
  # made a wrong answer expensive. A wrong answer is now a line of noise, which
  # is the worst a heuristic reading someone else's database should ever cost.
  #
  # After the probe, too: the probe is the one hard measurement here, and running
  # the heuristic first meant a wrong guess from it hid a real 502 behind advice
  # to run a search-replace.
  # Ask the database which hostnames it actually holds.
  #
  # Everything above compares configuration against configuration, and adopting
  # production-canonical is a pincer between two states configuration cannot
  # tell apart. A worktree whose branch predates the parent's hostshift.yaml has
  # a map built from DDEV hostnames — which is *correct* while the database still
  # holds them, and both variants return 200 — and check refused it on every
  # start, every statement in the warning false. Merge the file, as that warning
  # says, and check reports "hostshift is serving" and exits 0 while both URLs
  # 302 to wp-signup, because the database has not moved yet. The developer's
  # only escape from a permanent red is the action that silently breaks the site.
  #
  # One query separates them, and the add-on already talks to this database in
  # copy-db. Best-effort throughout: no container, no WordPress, an unusual table
  # prefix or a stopped db all yield nothing, and nothing is not evidence.
  # ${DB_HOST:-db} — the database the *application* reads, not the one beside it.
  #
  # `-h db` is the worktree's own container, and the README's headline answer to
  # "the worktree has an empty database" is to share the parent's. On exactly
  # that configuration the query hit an idle container holding a leftover
  # install, so a site serving 200s with every link correctly rewritten was told
  # its database names a hostname the map does not cover — refused on every
  # start, every clause false. Worse, the remedy it printed is destructive there:
  # `ddev wp` targets the parent, so the search-replace it recommends would
  # rewrite the parent's real content to a throwaway worktree hostname.
  #
  # copy-db thirty lines up already asks the web container for DB_HOST for this
  # exact reason. Running the query inside the container with its own environment
  # inherits that knowledge instead of duplicating it.
  # `wp db query`, which reads the *row*, not the application's opinion of it.
  #
  # Reading DB_HOST from the container's shell environment was not the same
  # question. The README's "Share the parent's" section sets DATABASE_URL, not
  # DB_HOST, and Bedrock keeps credentials in a dotenv file that no `printenv`
  # can see — so on the README's headline configuration the query hit the
  # worktree's own idle container instead of the database the application reads.
  #
  # That was wrong in both directions, and the silent one is worse: a stale
  # answer from the idle container *cleared* the parent-declares warning, so a
  # preview serving live production origins was certified healthy. Reading a
  # different database and calling it proof is the failure; asking the
  # application removes the question.
  #
  # `wp option get home` was the wrong question, and PLAN §4.1 says why:
  # "the application self-reports and cannot be interrogated — the map must be
  # declared, never discovered". get_option('home') runs through
  # `add_filter('option_home', '_config_wp_home')`, which WordPress registers
  # unconditionally and which returns WP_HOME whenever it is defined — and
  # Bedrock always defines it, from HTTP_HOST or DDEV_PRIMARY_URL. So under
  # `ddev exec`, with no HTTP_HOST, the answer was the worktree's own project
  # hostname, which is by construction neither canonical nor variant: a refusal
  # on every start of a healthy site. And where a repo has wp-cli.local.yml, its
  # `url:` sets HTTP_HOST, so the answer always equalled a canonical host and the
  # check cleared the parent-declares warning by echoing generated config back at
  # itself.
  #
  # The row is not an opinion. wp-cli resolves the connection from wp-config.php,
  # so Bedrock's dotenv and the README's DATABASE_URL are both handled — the
  # thing the shell-environment version got wrong — while `db query` bypasses
  # every filter.
  #
  # Best-effort, and silence is the only safe failure. No wp-cli, no WordPress,
  # a stopped container or an unusual layout all yield nothing — and nothing
  # neither clears a warning nor raises one, because an answer we cannot trust
  # must not be treated as evidence in either direction.
  # The first line that looks like a URL, not `tail -1`.
  #
  # `wp db query` ends its output with a blank line, so `tail -1` assigned an
  # empty string and the whole gate below — refusal *and* the parent-declares
  # clearing — silently never ran. `option get home`, which this replaced,
  # emitted exactly one line, which is why the idiom survived the change. Third
  # time this gate has been wrong, and the first time it was wrong in the
  # direction that says nothing at all.
  #
  # Matching the shape rather than a position also skips a column header or a
  # warning line, and `sed -n '…{p;q;}'` is the file's existing way of taking a
  # first match without `head -1` SIGPIPEing the writer under pipefail.
  # -d, because `ddev exec -s web` runs in /var/www/html and WordPress is under
  # the docroot. Without it wp-cli errored, the error was swallowed, and the
  # gate reported nothing on every project whose root has no wp-cli.yml `path:`.
  # An `if`, not `[ -n "$dr" ] && …`: under `set -e` a false `&&` chain is the
  # command's own exit status, so an empty docroot ended the script right here.
  wproot="/var/www/html"
  dr="$(ddev_docroot .ddev)"
  if [ -n "$dr" ]; then
    wproot="/var/www/html/$dr"
  fi
  dbhome="$(ddev exec -s web -d "$wproot" wp --skip-plugins --skip-themes --quiet db query \
    "select option_value from wp_options where option_name='home' limit 1" --skip-column-names \
    2>/dev/null | tr -d '\r' | sed -n '/^https\{0,1\}:\/\//{p;q;}' || true)"
  dbhost=""
  case "$dbhome" in
    http://*|https://*) dbhost="$(printf '%s' "$dbhome" | sed -e 's|^https\{0,1\}://||' -e 's|[/:].*$||')" ;;
  esac

  if [ -n "$dbhost" ]; then
    canon_hosts="$(hostshift map --slug "$slug" "${map_args[@]+"${map_args[@]}"}" \
      --canonical-hosts 2>/dev/null | sort -u || true)"
    known=""
    while IFS= read -r h; do
      [ "$h" = "$dbhost" ] && { known=1; break; }
    done <<<"$canon_hosts"
    # A positive answer here settles the parent-declares question below: the
    # database's own home is in the map, so the map is not on the wrong side,
    # whatever the parent's hostshift.yaml declares. A measured row beats an
    # inference drawn from two config files.
    if [ -n "$known" ]; then
      db_confirms_map=1
    fi
    if [ -z "$known" ]; then
      echo "hostshift: warning: the database says its home is $dbhome, which this" >&2
      echo "  map does not name. If that is right, nothing on the page is being" >&2
      echo "  rewritten and every link points at it. The map covers:" >&2
      printf '    %s\n' $canon_hosts >&2
      echo "  Either the database has not been moved to the hostnames" >&2
      echo "  hostshift.yaml declares, or the map is built from the wrong" >&2
      echo "  checkout. \`ddev hostshift wp-cli\` and a search-replace move it." >&2
    fi
  fi

  # What the page actually says it is.
  #
  # A stock DDEV WordPress pins WP_HOME to DDEV_PRIMARY_URL — this project's own
  # hostname, which is neither the canonical nor the variant. The preview then
  # serves seventeen links to `<project>.ddev.site`, nothing is rewritten
  # because nothing on the page names an origin the map knows, and every gate
  # here passed: the map is injective and anchored, the containers are up, the
  # probe answers 200, and the database's `home` row is whatever it is. Only
  # `hostshift diff` caught it, and the README points worktree users here.
  #
  # This is not discovery of the map — it is reading the one page this command
  # already fetched and noticing it is full of a hostname the map does not name.
  if [ -n "${probe_body:-}" ] && [ -n "${DDEV_HOSTNAME:-}" ]; then
    canon_list="$(hostshift map --slug "$slug" "${map_args[@]+"${map_args[@]}"}" \
      --canonical-hosts 2>/dev/null | paste -sd, - || true)"
    # Every hostname DDEV registers, not just the first. DDEV joins the project
    # hostname with each additional_hostnames entry, so reading one name looked
    # at a fraction of what the project answers to.
    owns="$(printf '%s' "${DDEV_HOSTNAME}" | tr ',' '\n')"
    while IFS= read -r own; do
      [ -n "$own" ] || continue
      # A hostname the map already covers is not a stranger.
      case ",$variants," in *",$own,"*) continue ;; esac
      case ",$canon_list," in *",$own,"*) continue ;; esac
      # `case`, not `printf | grep -q`. Under `set -o pipefail` a `grep -q` that
      # matches early exits while printf is still writing, printf takes SIGPIPE,
      # and the pipeline returns 141 — so the `if` was false on every body past
      # the 64 KiB pipe buffer, which is every WordPress page. The warning could
      # not fire on any deployment that had the problem, and the shipped test
      # passed because its fixture body is 41 bytes. This file documents the
      # same hazard in three other places and this walked into it anyway.
      case "$probe_body" in
        *"//$own"*)
          echo "hostshift: warning: the page served at https://$probe answers with" >&2
          echo "  links to $own, which is neither a canonical hostname nor a" >&2
          echo "  variant — so those links are not being rewritten and do not" >&2
          echo "  reach this preview. A stock DDEV WordPress does this: its" >&2
          echo "  wp-config-ddev.php pins WP_HOME to DDEV_PRIMARY_URL. Remove" >&2
          echo "  that pin, or set WP_HOME to a canonical hostname." >&2
          break ;;
      esac
    done <<<"$owns"
  fi

  # The parent-declares verdict, now that the database has had its say.
  #
  # This was a refusal, and it has been wrong in one direction or the other for
  # seven consecutive rounds — the last time costing a working deployment,
  # because a developer who follows the printed remedy on a database that holds
  # DDEV hostnames turns every page into a wp-signup.php redirect. That is the
  # action this file's own comments elsewhere call "the action that silently
  # breaks the site".
  #
  # So it keeps the signal and gives up the authority, for the same reason the
  # database gate did in d203760: a wrong answer now costs a line of noise
  # rather than every boot of a healthy site. The probe above is the hard
  # measurement and it still refuses.
  # Two independent facts, both reported, neither silencing the other.
  #
  # db_confirms_map was allowed to suppress this entirely, and it cannot: the
  # row is about *one* origin — whatever `wp_options.home` happens to hold —
  # while `unmapped` is a set difference over everything the parent declares.
  # When `copy-db` had left `home` holding a DDEV hostname, the row was
  # satisfied, the subset test's finding was thrown away, and a declared
  # production canonical was served to the browser unrewritten with check
  # exit 0. That re-opened the leak the subset test was added in the same
  # commit to close.
  #
  # So the row now qualifies the warning instead of cancelling it. It is real
  # evidence and worth printing — a developer whose database has not moved needs
  # to know the map matches it — but it cannot speak for origins it says nothing
  # about.
  if [ -n "$parent_declares" ]; then
    [ -n "$parent_declares_msg" ] && parent_declares_warn
    if [ -n "${unmapped:-}" ]; then
      echo "  Declared there and not in this map:" >&2
      printf '    %s\n' $unmapped >&2
    fi
    if [ -n "$db_confirms_map" ]; then
      echo "  The database's own home is in the map, so if none of those" >&2
      echo "  hostnames appear in content this is expected — that is what" >&2
      echo "  \`copy-db\` plus a search-replace leaves behind." >&2
    fi
  fi

  printf '\n  hostshift is serving:\n' >&2
  printf '    https://%s\n' $(printf '%s' "$variants" | tr ',' ' ') >&2
  printf '\n' >&2
  exit 0
fi


if [ "$cmd" = "init" ] && [ -n "$unreadable_parent" ] && [ ! -f hostshift.yaml ]; then
  echo "hostshift: refusing to write a map built from this worktree's own" >&2
  echo "  hostnames. $unreadable_parent could not be read, so the canonical side" >&2
  echo "  would be the hostname this worktree is *served at* — nothing would be" >&2
  echo "  rewritten — and web would keep the parent's hostnames, which both" >&2
  echo "  projects would then claim. Fix that checkout, or declare the hostnames" >&2
  echo "  the database really holds in hostshift.yaml." >&2
  exit 2
fi

# The production hostnames are already declared, in hostshift.yaml's canonical
# and aliases. Writing them a second time by hand into a compose file is how the
# two come to disagree — and the failure of disagreeing is wp-cron POSTing to the
# client's live site from a box holding a production database. Same shape as
# wp-cli: it prints, you redirect.
if [ "$cmd" = "loopback" ]; then
  # Canonical *and* aliases: an alias is a production hostname the content may
  # still name, so leaving it out is the same leak with a different spelling.
  hosts_out="$(hostshift map --slug "$slug" "${map_args[@]+"${map_args[@]}"}" \
    --canonical-hosts | sort -u)"
  # Off-box means "not one this DDEV project answers to". The project's own TLD
  # is the tail of its primary hostname, which `hostshift hosts` prints first.
  # sed, not `| head -1`: this script runs under `set -o pipefail`, and a head
  # that exits after one line SIGPIPEs whatever is still writing. The same
  # pattern is called out twice elsewhere in this file; $hosts is short enough
  # that it has never fired, which is exactly why it would be a surprise.
  tld="$(printf '%s\n' "$hosts" | sed -n 1p | cut -d. -f2-)"
  offbox="$(printf '%s\n' "$hosts_out" | grep -v "\.${tld:-ddev.site}\$" || true)"
  if [ -z "$offbox" ]; then
    echo "hostshift: every canonical hostname is a local DDEV one, so the" >&2
    echo "  application's own internal requests already stay on this machine." >&2
    echo "  Nothing to contain." >&2
    exit 0
  fi
  echo "#ddev-silent-no-warn"
  echo "# generated by \`ddev hostshift loopback\` from hostshift.yaml — do not edit"
  echo "services:"
  echo "  web:"
  echo "    extra_hosts:"
  printf '      - "%s:127.0.0.1"\n' $offbox
  exit 0
fi

if [ "$cmd" = "env" ]; then
  printf '%s\n' "$env_out"
  exit 0
fi

# wp-cli.local.yml *replaces* wp-cli.yml rather than merging with it — measured
# with WP-CLI 2.12.0, where a file carrying only `url:` lost `path:`, `require:`
# and every alias, and WP-CLI then could not find the installation at all. So
# the whole config goes through with a root url added.
#
# Appending a top-level key is all that takes, and it beats a YAML round trip:
# the original formatting, key order and comments survive untouched. This is
# WordPress's business, not the proxy's — hostshift does not know what a CMS is.
#
# Two details make the difference between valid YAML and a parse error. A
# wp-cli.yml with no trailing newline (what printf and several editors produce)
# glues `url:` onto its last line — "require: wp-cli.phpurl: https://…". And a
# wp-cli.yml that already has a root `url:` gets it twice, which yaml.v3 rejects
# outright as a duplicate key.
if [ "$cmd" = "wp-cli" ]; then
  # Likewise no `| head -1 | cut`: hostshift would be killed by SIGPIPE mid-write
  # and pipefail would take the exit code, so `wp-cli` failed with "no canonical
  # origin in the map" on Linux and passed on macOS.
  canonical="$(hostshift map --slug "$slug" "${map_args[@]+"${map_args[@]}"}" --pairs \
    | sed -n '1s/=.*//p')"
  [ -n "$canonical" ] || { echo "no canonical origin in the map" >&2; exit 2; }
  echo "# generated by \`ddev hostshift wp-cli\` — do not commit"
  if [ -f wp-cli.yml ]; then
    sed -e '/^url:[[:space:]]/d' wp-cli.yml
    echo
  fi
  echo "url: $canonical"
  exit 0
fi

# One file, not two. Registering the variants in additional_hostnames was
# believed to be what put them in the mkcert certificate's SAN — and it is not.
# DDEV builds that SAN list from the project's hostnames *plus every
# VIRTUAL_HOST entry across all compose services* (pkg/ddevapp/traefik.go,
# detectAppRouting: "There can possibly be VIRTUAL_HOST entries which are not
# configured hostnames"), unchanged from v1.23 to v1.25. The compose service
# already puts HOSTSHIFT_VARIANTS in VIRTUAL_HOST, so the certificate already
# covers them. Measured on v1.25.2 with no config.hostshift.local.yaml on disk
# at all: the served cert carried DNS:wt-a--shop.acme.ddev.site — three labels,
# never registered — and openssl verified it against the mkcert root, return
# code 0.
#
# The two inputs do different jobs, which the old comment conflated:
# additional_hostnames drives /etc/hosts, the cert SANs and `ddev describe`;
# VIRTUAL_HOST drives the traefik routers *and* the cert SANs. So VIRTUAL_HOST
# is a strict superset of what this needs, and the generated file was redundant.
#
# Not writing it is worth more than the file it saves. It was a
# .ddev/config.*.yaml, so hostshift read it back as input on the next run — the
# variants returned as canonical hosts, got variants of their own, and
# additional_hostnames grew without bound. That whole hazard, and the marker
# that suppressed it, existed only because of this file.
#
# Caveat, untested: on a custom project_tld that does not resolve publicly,
# additional_hostnames is still what drives /etc/hosts, and a VIRTUAL_HOST-only
# name would get a certificate but no hosts entry. Every project in the fleet is
# on ddev.site, whose wildcard resolves at any depth.
if [ -n "$dry_run" ]; then
  echo "# .ddev/.env" ; printf '%s\n' "$env_out"
  hostshift map --slug "$slug" "${map_args[@]+"${map_args[@]}"}" >&2
  echo "hostshift: --dry-run, nothing written" >&2
  exit 0
fi

# Merged, not truncated: .ddev/.env is a project file that may hold something
# else already.
touch .ddev/.env
# In .ddev/ so the mv is a rename on one filesystem rather than a copy+unlink
# across two, which is not atomic — a concurrent compose read must never catch
# this half-written and see an empty VIRTUAL_HOST.
tmp="$(mktemp .ddev/.env.XXXXXX)"
trap 'rm -f "$tmp"' EXIT
# cp -p first, then truncate: that gives the temp file the mode the real one
# already had, and redirection keeps it. .ddev/.env is where DDEV documents
# putting project env vars, credentials included, so a developer who chmod 600'd
# it meant it.
cp -p .ddev/.env "$tmp"
{ grep -v -e '^HOSTSHIFT_ARGS=' -e '^HOSTSHIFT_VARIANTS=' -e '^HOSTSHIFT_WEB_HOSTS=' \
    -e '^HOSTSHIFT_SLUG_CHOSEN=' -e '^#ddev-silent-no-warn' .ddev/.env || true
  printf '%s\n' "$env_out"; } > "$tmp"
mv "$tmp" .ddev/.env

echo "hostshift: wrote .ddev/.env" >&2
hostshift map --slug "$slug" "${map_args[@]+"${map_args[@]}"}" >&2

# And pick it up. init always leaves the project stale — that is what it is for —
# so ending with the restart removes the step this file elsewhere calls the
# commonest failure there is: init without the `ddev restart` it just told you to
# run. env, wp-cli and --dry-run all exit above this line and never restart.
# Only when actually invoked through `ddev hostshift` — DDEV sets DDEV_APPROOT
# for a host command, and nothing else does. Run directly, from a test or by
# hand, init stays what it says on the tin: it writes a file.
if [ -n "${DDEV_APPROOT:-}" ] && command -v ddev >/dev/null; then
  echo "hostshift: restarting to pick it up" >&2
  # Not `exec`: that hands the exit status to `ddev restart`, and DDEV does not
  # fail a restart on a failing `exec-host` hook — a fact config.hostshift.yaml
  # documents at length, but only ever reasoned about for the hook itself. So
  # `ddev hostshift init` printed the warning, printed `refusing to call this
  # healthy`, printed `Task failed`, and exited **0** on a deployment whose map
  # named the wrong hostnames entirely. PLAN §3's premise is unattended agents
  # in worktrees, and an agent that checks $? was told everything was fine.
  #
  # So run the check again afterwards and answer with it. The hook has already
  # printed the diagnosis by then, so this stays quiet and only sets the status.
  ddev restart || exit $?
  # `.ddev/commands/host/hostshift`, not "$0": we have already cd'd to
  # $DDEV_APPROOT, so a relative $0 no longer resolves, and DDEV does not promise
  # an absolute one.
  self=".ddev/commands/host/hostshift"
  [ -x "$self" ] || self="$0"
  # ${slug_explicit:+…}, not ${slug:+…}. Passing --slug makes the sub-invocation
  # treat the slug as *chosen*, so its expected .ddev/.env carries a
  # HOSTSHIFT_SLUG_CHOSEN line that the file just written from a branch-derived
  # slug does not — and it reported the project it had just configured as out of
  # date. When the slug really was chosen the line is there and they agree; when
  # it was not, the sub-invocation re-derives the same slug from the same branch.
  if out="$(HOSTSHIFT_HOOK=1 "$self" check ${slug_explicit:+--slug "$slug"} 2>&1)"; then
    exit 0
  fi
  # The post-start hook has usually printed this already, but not always — a
  # `check` that fails for a reason the hook could not reach prints nothing
  # otherwise, and exiting non-zero with no explanation is worse than repeating
  # a few lines.
  printf '%s\n' "$out" >&2
  echo "hostshift: restarted, but the result is not healthy." >&2
  exit 2
fi
echo "hostshift: now run \`ddev restart\`" >&2
